---
/**
 * Proyectos ejecutivos · Hero. Misma forma que los otros héroes: la lámina de papel que cubre también la cabecera,
 * el H1 con la búsqueda, un solo botón, una línea de respaldo y el cajetín.
 * La pieza visual no usa planos (ya se ven en el resto de la web): es una vista explotada de un proyecto en cuatro
 * capas, una por disciplina, cada una con su simbología de plano (arquitectura: muros y puertas; estructural:
 * columnas, vigas y ejes; hidrosanitaria: tuberías con el agua corriendo; eléctrica: circuitos y puntos de luz).
 * Primero se trazan separadas y luego bajan y se apilan en un solo paquete; se separan y se juntan en bucle.
 * Es un esquema del servicio, no un proyecto: no lleva nombre, medidas ni datos.
 */
import Cifra from '../Cifra.astro';

// Isometría: planta (x, y) en unidades → pantalla. Huella en L de 8 × 6.
const U = 22;
const C = 0.866;
const iso = (x: number, y: number): [number, number] => [(x - y) * C * U, (x + y) * 0.5 * U];
const pt = (x: number, y: number) => iso(x, y).map((v) => v.toFixed(1)).join(' ');
const line = (pts: [number, number][]) => 'M' + pts.map(([x, y]) => pt(x, y)).join('L');
const L: [number, number][] = [[0, 0], [8, 0], [8, 4], [5, 4], [5, 6], [0, 6]];
const plate = line(L) + 'Z';
const inside = (x: number, y: number) => x >= 0 && y >= 0 && x <= 8 && y <= 6 && !(x > 5 && y > 4);
// arco de puerta (cuarto de círculo) en planta
const arc = (cx: number, cy: number, r: number, a0: number, a1: number) => {
  const pts: [number, number][] = [];
  for (let i = 0; i <= 10; i++) { const a = a0 + ((a1 - a0) * i) / 10; pts.push([cx + r * Math.cos(a), cy + r * Math.sin(a)]); }
  return line(pts);
};

// 01 Arquitectura: muros exteriores, muros interiores, puertas y ventanas
const arq = {
  walls: [line([...L, L[0]])],
  inner: [line([[3, 0], [3, 2.2]]), line([[3, 3.2], [3, 6]]), line([[0, 3], [1.9, 3]]), line([[5, 0], [5, 1.6]]), line([[5, 2.6], [5, 4]])],
  doors: [arc(3, 2.2, 1, Math.PI / 2, Math.PI), arc(1.9, 3, 1, 0, -Math.PI / 2), arc(5, 1.6, 1, Math.PI / 2, 0)],
  win: [line([[0.8, 0], [2.2, 0]]), line([[6, 0], [7.4, 0]]), line([[8, 1.2], [8, 2.8]]), line([[0, 4], [0, 5.4]])],
};
// 02 Estructural: ejes, columnas en los cruces dentro de la huella y vigas entre ellas
const gx = [0, 3, 5, 8];
const gy = [0, 3, 6];
const cols = gx.flatMap((x) => gy.filter((y) => inside(x, y)).map((y) => [x, y] as [number, number]));
const k = 0.22;
const est = {
  cols: cols.map(([x, y]) => line([[x - k, y - k], [x + k, y - k], [x + k, y + k], [x - k, y + k]]) + 'Z'),
  beams: [
    ...gy.map((y) => line([[0, y], [y > 4 ? 5 : 8, y]])),
    ...gx.map((x) => line([[x, 0], [x, x > 5 ? 4 : 6]])),
  ],
  axes: gx.map((x, i) => ({ d: line([[x, -0.4], [x, -1.3]]), c: iso(x, -1.7), t: 'ABCD'[i] })),
};
// 03 Hidrosanitaria: agua (continua, con flujo) y desagüe (discontinua) hasta los aparatos
const hid = {
  agua: line([[0.6, 5.4], [2.4, 5.4], [2.4, 3.6], [4.2, 3.6], [4.2, 0.9], [7.2, 0.9], [7.2, 3.2]]),
  desague: line([[1.4, 5.0], [1.4, 3.9], [3.6, 3.9], [3.6, 0.5], [7.6, 0.5]]),
  aparatos: [[2.4, 5.4], [4.2, 2.3], [7.2, 3.2], [7.2, 0.9]].map(([x, y]) => iso(x, y)),
};
// 04 Eléctrica: tablero, puntos de luz y circuitos curvos como en un plano eléctrico
const tablero = iso(0.5, 0.5);
const luces = [[1.6, 1.5], [4, 1.4], [6.6, 2.2], [1.6, 4.6], [4, 4.8]].map(([x, y]) => iso(x, y));
const curva = (a: [number, number], b: [number, number]) => {
  const mx = (a[0] + b[0]) / 2;
  const my = (a[1] + b[1]) / 2 - 16;
  return `M${a[0].toFixed(1)} ${a[1].toFixed(1)}Q${mx.toFixed(1)} ${my.toFixed(1)} ${b[0].toFixed(1)} ${b[1].toFixed(1)}`;
};
const ele = { circ: [curva(tablero, luces[0]), curva(luces[0], luces[1]), curva(luces[1], luces[2]), curva(luces[0], luces[3]), curva(luces[3], luces[4])] };

const capas = [
  { id: 'arq', n: '01', t: 'Arquitectura' },
  { id: 'est', n: '02', t: 'Estructural' },
  { id: 'hid', n: '03', t: 'Hidrosanitaria' },
  { id: 'ele', n: '04', t: 'Eléctrica' },
];
// separación de las capas abiertas y apiladas (unidades del viewBox)
const G = 70;
const g = 9;
const [rx, ry] = iso(8, 0); // esquina derecha de la placa: de ahí sale la etiqueta
---

<section class="vh" data-nav-label="Proyectos ejecutivos" aria-labelledby="vh-title" data-vh>
  <div class="vh-paper" aria-hidden="true"></div>
  <div class="vh-in">
    <div class="vh-copy">
      <nav class="vh-crumbs" aria-label="Ruta">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/#servicios">Servicios</a><span aria-hidden="true">/</span><span aria-current="page">Proyectos ejecutivos</span>
      </nav>
      <h1 id="vh-title" class="vh-h1">
        <span class="ln"><span class="ln-in">Proyecto ejecutivo</span></span>{' '}
        <span class="ln"><span class="ln-in accent">listo para licencia y obra<svg class="underline" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 15 C 70 9, 150 8, 230 10 S 360 14, 396 9"></path><path pathLength="1" class="u2" d="M40 19 C 120 15, 230 15, 330 17"></path></svg></span></span>
      </h1>
      <p class="vh-sub">Arquitectura e ingenierías estructural, hidrosanitaria y eléctrica en un solo paquete, coordinado por nuestro equipo.</p>
      <div class="vh-act">
        <a href="#cotizar" class="btn chamfer" data-open-chat data-cta="ejecutivo-hero" data-service="ejecutivo">
          Cotiza tu proyecto
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
        </a>
      </div>
      <p class="vh-proof"><Cifra v={60} /> proyectos diseñados<span class="pr-more"><span aria-hidden="true">·</span>un solo responsable de todos los planos</span></p>
    </div>

    <!-- Las cuatro disciplinas en capas: se trazan abiertas y se apilan en un solo paquete -->
    <figure class="vh-model" aria-label="Esquema de un proyecto ejecutivo: capas de arquitectura, estructural, hidrosanitaria y eléctrica que se apilan en un solo paquete">
      <div class="vh-stage">
        <svg class="ex" viewBox="-150 -50 470 440" data-ex style={`--G:${G}px;--g:${g}px`} aria-hidden="true">
          {
            capas.map((c, i) => ({ c, i })).reverse().map(({ c, i }) => (
              <g class={`ly ly-${c.id}`} style={`--k:${i}`}>
                <path class="pl-sh" d={plate} transform="translate(0 7)" />
                <path class="pl" d={plate} />
                {c.id === 'arq' && (
                  <g class="dr">
                    {arq.walls.map((d) => <path class="a-wall" d={d} pathLength="1" />)}
                    {arq.inner.map((d) => <path class="a-in" d={d} pathLength="1" />)}
                    {arq.doors.map((d) => <path class="a-door" d={d} pathLength="1" />)}
                    {arq.win.map((d) => <path class="a-win" d={d} pathLength="1" />)}
                  </g>
                )}
                {c.id === 'est' && (
                  <g class="dr">
                    {est.beams.map((d) => <path class="e-beam" d={d} pathLength="1" />)}
                    {est.cols.map((d, j) => <path class="e-col" d={d} style={`--j:${j}`} />)}
                    {est.axes.map((a) => (
                      <g class="e-ax">
                        <path d={a.d} pathLength="1" />
                        <circle cx={a.c[0]} cy={a.c[1]} r="7" />
                        <text x={a.c[0]} y={a.c[1] + 3}>{a.t}</text>
                      </g>
                    ))}
                  </g>
                )}
                {c.id === 'hid' && (
                  <g class="dr">
                    <path class="h-des" d={hid.desague} />
                    <path class="h-agua" d={hid.agua} pathLength="1" />
                    <path class="h-flow" d={hid.agua} pathLength="100" />
                    {hid.aparatos.map(([x, y], j) => <circle class="h-ap" cx={x} cy={y} r="3.6" style={`--j:${j}`} />)}
                  </g>
                )}
                {c.id === 'ele' && (
                  <g class="dr">
                    {ele.circ.map((d) => <path class="l-circ" d={d} />)}
                    <path class="l-flow" d={ele.circ.join('')} pathLength="100" />
                    <rect class="l-tab" x={tablero[0] - 5} y={tablero[1] - 3.5} width="10" height="7" />
                    {luces.map(([x, y], j) => (
                      <g class="l-pt" style={`--j:${j}`} transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
                        <circle r="4.6" />
                        <path d="M-3.2 -3.2L3.2 3.2M3.2 -3.2L-3.2 3.2" />
                      </g>
                    ))}
                  </g>
                )}
                <g class="tag">
                  <path class="tag-ln" d={`M${(rx + 8).toFixed(1)} ${ry.toFixed(1)}H${(rx + 34).toFixed(1)}`} />
                  <text class="tag-n" x={rx + 40} y={ry + 5}>{c.n}</text>
                  <text class="tag-t" x={rx + 62} y={ry + 5}>{c.t}</text>
                </g>
              </g>
            ))
          }
          <g class="pk" transform={`translate(${(rx + 8).toFixed(1)} ${(ry + 1.5 * G + 1.5 * g).toFixed(1)})`}>
            <path class="pk-br" d={`M0 ${-2 * g - 6}h8v${4 * g + 12}h-8`} />
            <text class="pk-t" x="16" y="-2">Un solo</text>
            <text class="pk-t" x="16" y="16">paquete</text>
          </g>
        </svg>
      </div>
    </figure>

    <!-- Pie: el cajetín del juego de planos -->
    <div class="vh-foot">
      <figcaption class="cajetin">
        <span class="caj-c caj-main"><span class="caj-l">Proyecto ejecutivo</span><b>4 disciplinas, 1 paquete</b><span class="caj-d" data-ex-state>arquitectura e ingenierías por capas</span></span>
        <span class="caj-c caj-n"><span class="caj-l">Coordina</span><b>Galezo Studio</b></span>
      </figcaption>
    </div>
  </div>
</section>
<script is:inline>
  // La entrada del héroe empieza con el primer pintado, sin esperar al JS del módulo (que la repite sin efecto):
  // el texto y la imagen principal aparecen ~1 s antes en celular.
  (function (s) { if (s && document.documentElement.classList.contains('js')) requestAnimationFrame(function () { requestAnimationFrame(function () { s.classList.add('is-in'); }); }); })(document.currentScript.previousElementSibling);
</script>

<style>
  .vh {
    --hd: 76px;
    --pad: 20px;
    --g: 8px;
    position: relative;
    isolation: isolate;
    height: 100svh;
    min-height: 560px;
    display: flex;
    padding: calc(var(--hd) + 18px) calc(var(--pad) + var(--g)) calc(var(--g) + 10px);
    background: #fff;
    overflow: hidden;
  }
  /* La lámina: papel hueso con margen blanco, cortes a 45° y el azul de la marca muy tenue arriba a la izquierda */
  .vh-paper {
    position: absolute;
    inset: var(--g);
    z-index: -1;
    background:
      radial-gradient(60% 55% at 0% 0%, rgb(54 114 124 / 0.11), rgb(54 114 124 / 0.04) 50%, rgb(54 114 124 / 0) 78%),
      radial-gradient(45% 38% at 50% 32%, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0) 100%),
      var(--color-bone);
    clip-path: polygon(26px 0, 100% 0, 100% calc(100% - 26px), calc(100% - 26px) 100%, 0 100%, 0 26px);
  }
  .vh-in { flex: 1; min-height: 0; width: 100%; max-width: 1200px; margin: 0 auto; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: 8px; }
  .vh-copy { display: grid; justify-items: center; text-align: center; gap: clamp(8px, 1.5svh, 14px); }
  .vh-crumbs { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; font-size: 12.5px; color: var(--color-ink-mute); }
  .vh-crumbs a { color: var(--color-ink-mute); transition: color 0.3s; }
  .vh-crumbs a:hover { color: var(--color-brand-ink); }
  .vh-crumbs [aria-current] { color: var(--color-ink-soft); font-weight: 600; }
  .vh-h1 { font-size: clamp(1.9rem, min(1.4rem + 3.4vw, 6.2svh), 4.1rem); line-height: 1.02; font-weight: 560; letter-spacing: -0.04em; text-wrap: balance; }
  .vh-h1 .ln { display: block; overflow: hidden; padding: 0.04em 0.06em 0.3em; margin-bottom: -0.26em; }
  .vh-h1 .ln-in { display: inline-block; }
  .vh-h1 .accent { position: relative; font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; color: var(--color-brand); font-size: 1.08em; }
  /* subrayado a mano, como en el inicio */
  .underline { position: absolute; left: -2%; width: 104%; bottom: -0.2em; height: 0.28em; overflow: visible; pointer-events: none; }
  .underline path { fill: none; stroke: var(--color-brand); stroke-width: 3.2; stroke-linecap: round; vector-effect: non-scaling-stroke; opacity: 0.85; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .underline .u2 { stroke-width: 2; opacity: 0.5; }
  .vh.is-in .underline path { stroke-dashoffset: 0; transition: stroke-dashoffset 0.9s 0.7s cubic-bezier(0.5, 0, 0.2, 1); }
  .vh.is-in .underline .u2 { transition-delay: 0.95s; }
  .vh-sub { max-width: 34rem; font-size: clamp(0.92rem, 0.85rem + 0.3vw, 1.05rem); line-height: 1.5; color: var(--color-ink-soft); text-wrap: balance; }
  .vh-act { position: relative; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px 22px; margin-top: 2px; }
  .btn { --cut: 9px; display: inline-flex; align-items: center; gap: 8px; height: 50px; padding: 0 24px; font-size: 15px; font-weight: 560; background: var(--color-brand-ink); color: #fff; transition: background-color 0.3s; }
  .btn:hover { background: var(--color-ink); }
  .btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.45s var(--ease-out-expo); }
  .btn:hover svg { transform: translateX(3px); }
  /* respaldo: una sola línea discreta bajo el botón */
  .vh-proof { font-size: 13px; color: var(--color-ink-mute); }
  .vh-proof :global(.cf) { font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: 1.35em; color: var(--color-brand); margin: 0 0.5em 0 0.3em; }
  .vh-proof .pr-more span { margin: 0 6px; }
  /* celular: solo la cifra, en una línea */
  @media (max-width: 639px) { .vh-proof .pr-more { display: none; } }

  /* ---------- Las capas ---------- */
  .vh-model { position: relative; min-height: 0; margin: 0; display: grid; }
  .vh-stage { position: relative; min-height: 0; }
  .ex { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* cada capa: abierta (k · G) o apilada (centrada sobre el mismo punto, con poca separación) */
  .ly { transform: translateY(calc(var(--k) * var(--G))); transition: transform 1.1s cubic-bezier(0.65, 0, 0.25, 1); transition-delay: calc((3 - var(--k)) * 0.06s); }
  .ex.is-stack .ly { transform: translateY(calc(1.5 * var(--G) + (var(--k) - 1.5) * var(--g))); transition-delay: calc(var(--k) * 0.06s); }
  .pl { fill: rgb(255 255 255 / 0.93); stroke: rgb(35 38 43 / 0.28); stroke-width: 1; stroke-linejoin: round; }
  .pl-sh { fill: rgb(20 45 50 / 0.07); }
  .ex path, .ex circle, .ex rect { vector-effect: non-scaling-stroke; }
  .tag-ln { stroke: rgb(35 38 43 / 0.35); stroke-width: 1; }
  .tag-n { font-family: var(--font-serif); font-style: italic; font-size: 15px; fill: var(--color-brand); }
  .tag-t { font-family: var(--font-sans); font-size: 14.5px; font-weight: 620; fill: var(--color-ink); letter-spacing: -0.01em; }
  .tag { transition: opacity 0.5s; }
  .ex.is-stack .tag { opacity: 0; transition-delay: 0s; }
  .pk { opacity: 0; transition: opacity 0.5s; }
  .ex.is-stack .pk { opacity: 1; transition-delay: 0.8s; }
  .pk-br { fill: none; stroke: var(--color-brand); stroke-width: 1.5; }
  .pk-t { font-family: var(--font-serif); font-style: italic; font-size: 19px; fill: var(--color-brand-ink); }

  /* simbología de cada disciplina */
  .a-wall { fill: none; stroke: var(--color-brand-ink); stroke-width: 3.2; stroke-linejoin: round; }
  .a-in { fill: none; stroke: var(--color-brand-ink); stroke-width: 2; stroke-linecap: round; }
  .a-door { fill: none; stroke: var(--color-brand); stroke-width: 1; }
  .a-win { fill: none; stroke: #fff; stroke-width: 2.2; }
  .e-beam { fill: none; stroke: rgb(35 38 43 / 0.55); stroke-width: 1.3; }
  .e-col { fill: var(--color-ink); }
  .e-ax path { stroke: rgb(35 38 43 / 0.35); stroke-width: 0.8; stroke-dasharray: 3 2; }
  .e-ax circle { fill: #fff; stroke: rgb(35 38 43 / 0.45); stroke-width: 0.9; }
  .e-ax text { font-family: var(--font-serif); font-style: italic; font-size: 8.5px; text-anchor: middle; fill: var(--color-ink-soft); }
  .h-agua { fill: none; stroke: var(--color-brand); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .h-des { fill: none; stroke: rgb(34 88 97 / 0.55); stroke-width: 1.3; stroke-dasharray: 5 3; }
  .h-flow { fill: none; stroke: #fff; stroke-width: 1.4; stroke-linecap: round; stroke-dasharray: 0.1 6; opacity: 0; }
  .h-ap { fill: #fff; stroke: var(--color-brand); stroke-width: 1.4; }
  .l-circ { fill: none; stroke: var(--color-ink-soft); stroke-width: 1; stroke-dasharray: 4 2.5; }
  .l-flow { fill: none; stroke: var(--color-brand); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 4 96; opacity: 0; }
  .l-tab { fill: var(--color-ink); }
  .l-pt circle { fill: #fff; stroke: var(--color-ink); stroke-width: 1.1; }
  .l-pt path { stroke: var(--color-ink); stroke-width: 1; }

  /* trazo inicial: cada capa se dibuja una tras otra */
  :global(html.js) .ex [pathLength='1'] { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(html.js) .ex :is(.e-col, .h-ap, .l-pt, .l-tab, .l-circ, .h-des) { opacity: 0; }
  :global(html.js) .ex .tag { opacity: 0; }
  :global(html.js) .ex.is-draw [pathLength='1'] { stroke-dashoffset: 0; transition: stroke-dashoffset 0.9s cubic-bezier(0.5, 0, 0.2, 1); transition-delay: calc(var(--k) * 0.55s); }
  :global(html.js) .ex.is-draw .ly { --d: calc(var(--k) * 0.55s); }
  :global(html.js) .ex.is-draw :is(.e-col, .h-ap, .l-pt) { opacity: 1; transition: opacity 0.4s; transition-delay: calc(var(--d) + 0.4s + var(--j) * 0.06s); }
  :global(html.js) .ex.is-draw :is(.l-tab, .l-circ, .h-des) { opacity: 1; transition: opacity 0.6s; transition-delay: calc(var(--d) + 0.2s); }
  :global(html.js) .ex.is-draw .tag { opacity: 1; transition: opacity 0.5s; transition-delay: calc(var(--d) + 0.3s); }
  :global(html.js) .ex.is-draw.is-stack .tag { opacity: 0; transition-delay: 0s; }
  /* agua y corriente en movimiento cuando la capa ya está trazada */
  .ex.is-flow .h-flow { opacity: 0.95; animation: ex-flow 2.4s linear infinite; }
  .ex.is-flow .l-flow { opacity: 0.9; animation: ex-flow 3s linear infinite; }
  @keyframes ex-flow { to { stroke-dashoffset: -100; } }
  :global(html.rm) .ex .ly, :global(html.rm) .ex * { transition: none !important; animation: none !important; }

  /* ---------- Pie: cajetín ---------- */
  .vh-foot { display: flex; align-items: flex-end; justify-content: center; gap: 16px; }
  .cajetin { display: flex; align-items: stretch; width: 100%; max-width: 440px; border: 1px solid rgb(35 38 43 / 0.4); background: rgb(255 253 249 / 0.94); font-size: 11px; line-height: 1.2; color: #23262b; }
  .caj-c { display: grid; align-content: center; gap: 2px; padding: 6px 11px 7px; }
  .caj-c + .caj-c { border-left: 1px solid rgb(35 38 43 / 0.25); }
  .caj-l { font-size: 9.5px; color: #7a7f87; }
  .caj-c b { font-size: 12.5px; font-weight: 650; white-space: nowrap; }
  .caj-d { font-size: 11px; color: #5c616a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .caj-main { flex: 1; min-width: 0; }
  .caj-n .of { font-weight: 400; color: #7a7f87; }

  /* celulares bajitos: la ruta sobra (va en los datos estructurados) */
  @media (max-height: 700px) and (max-width: 639px) {
    .vh-crumbs { display: none; }
    .vh-act { gap: 8px 18px; }
    .btn { height: 46px; }
  }
  @media (max-width: 639px) {
    .caj-n { display: none; }
  }
  /* celulares chicos (SE): título en dos líneas y sin la línea de respaldo, para que las láminas tengan aire */
  @media (max-width: 639px) and (max-height: 600px) {
    .vh-h1 { font-size: 1.72rem; }
    .vh-sub { font-size: 0.86rem; line-height: 1.4; }
    .vh-proof { display: none; }
    .vh-copy { gap: 7px; }
  }

  /* ---------- Entrada ---------- */
  :global(html.js) .vh .ln-in { transform: translateY(105%); }
  :global(html.js) .vh.is-in .ln-in { transform: none; transition: transform 1s var(--ease-out-expo); }
  :global(html.js) .vh.is-in .ln + .ln .ln-in { transition-delay: 0.08s; }
  :global(html.js) .vh :is(.vh-crumbs, .vh-sub, .vh-act, .vh-proof, .vh-foot) { opacity: 0; transform: translateY(12px); }
  :global(html.js) .vh.is-in :is(.vh-crumbs, .vh-sub, .vh-act, .vh-proof, .vh-foot) { opacity: 1; transform: none; transition: opacity 0.7s, transform 0.9s var(--ease-out-expo); }
  :global(html.js) .vh.is-in .vh-sub { transition-delay: 0.15s; }
  :global(html.js) .vh.is-in .vh-act { transition-delay: 0.25s; }
  :global(html.js) .vh.is-in .vh-proof { transition-delay: 0.35s; }
  :global(html.js) .vh.is-in .vh-foot { transition-delay: 0.5s; }
  :global(html.js) .vh .vh-stage { opacity: 0; transform: translateY(24px) scale(0.97); }
  :global(html.js) .vh.is-in .vh-stage { opacity: 1; transform: none; transition: opacity 0.9s 0.2s, transform 1.2s 0.2s var(--ease-out-expo); }
  :global(html.rm) .vh * { transition: none !important; }
  :global(html.rm) .vh :is(.ln-in, .vh-crumbs, .vh-sub, .vh-act, .vh-proof, .vh-foot, .vh-stage) { opacity: 1 !important; transform: none !important; }
  :global(html.rm) .vh .underline path { stroke-dashoffset: 0 !important; }

  /* ---------- Tableta ---------- */
  @media (min-width: 640px) {
    .vh { --pad: 28px; }
  }
  /* ---------- Escritorio: texto a la izquierda, láminas a la derecha, cajetín abajo ---------- */
  @media (min-width: 1024px) {
    .vh { --pad: max(40px, calc((100% - 1200px) / 2)); --hd: 84px; padding-top: calc(var(--hd) + 24px); padding-bottom: calc(var(--g) + 14px); }
    /* la pieza y su cajetín van juntos, centrados en alto frente al texto */
    .vh-in { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto auto minmax(0, 1fr); align-items: center; gap: 0 32px; }
    .vh-copy { grid-column: 1; grid-row: 1 / -1; align-self: center; }
