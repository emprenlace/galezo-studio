</style>

<script>
  // avisa a la red de seguridad de Base que el JS cargó (si no, a los 2,5 s se apagan las animaciones de toda la página)
  document.documentElement.classList.add('ready');
  const sec = document.querySelector<HTMLElement>('[data-vh]');
  if (sec) {
    requestAnimationFrame(() => requestAnimationFrame(() => sec.classList.add('is-in')));
    const ex = sec.querySelector<SVGSVGElement>('[data-ex]')!;
    const state = sec.querySelector<HTMLElement>('[data-ex-state]')!;
    const reduced = document.documentElement.classList.contains('rm');
    const txt = { open: 'arquitectura e ingenierías por capas', stack: 'todo coordinado en un solo paquete' };
    if (reduced) {
      ex.classList.add('is-draw');
    } else {
      // 1) se trazan las cuatro capas  2) corre el agua y la corriente  3) se apilan y se abren en bucle mientras se ve
      let visible = true;
      let timer = 0;
      const toggle = () => {
        clearTimeout(timer);
        if (!visible) return;
        const stack = !ex.classList.contains('is-stack');
        ex.classList.toggle('is-stack', stack);
        state.textContent = stack ? txt.stack : txt.open;
        timer = window.setTimeout(toggle, stack ? 3200 : 4200);
      };
      setTimeout(() => ex.classList.add('is-draw'), 700);
      setTimeout(() => ex.classList.add('is-flow'), 3200);
      timer = window.setTimeout(toggle, 5200);
      new IntersectionObserver((es) => {
        const was = visible;
        visible = es[0].isIntersecting;
        if (visible && !was) timer = window.setTimeout(toggle, 1500);
        if (!visible) clearTimeout(timer);
      }, { threshold: 0.2 }).observe(ex);
    }
  }
</script>
