---
/**
 * Sección 4 · "Proyectos": del dibujo a la obra, en pantalla grande.
 * Cada obra entra como dibujo a lápiz (sacado de su propia foto: trazo, achurado y grano de papel) y una línea de obra con luz la recorre:
 * lo que queda atrás ya es la foto real, con un acercamiento lento de cine. La línea se puede arrastrar.
 * La ficha va sobre la imagen; el selector es una tira de obras con barra de avance (como historias).
 */
import { Image, getImage } from 'astro:assets';
import Plomada from './Plomada.astro';
import Trazos from './Trazos.astro';
import mono from '../assets/brand/monogram-d.txt?raw';
import gobernacion from '../assets/clientes/gobernacion-cesar.png';
import alcaldia from '../assets/clientes/alcaldia-valledupar.png';
import aconstruir from '../assets/clientes/a-construir.png';
import codazzi from '../assets/clientes/alcaldia-agustin-codazzi.png';
import jagua from '../assets/clientes/municipio-la-jagua-del-pilar.png';
import urumita from '../assets/clientes/alcaldia-urumita.png';
import hrs from '../assets/clientes/hrs-ingenieria.png';
import elbanco from '../assets/clientes/alcaldia-el-banco.png';
import corpocesar from '../assets/clientes/corpocesar.png';

import instpecam from '../assets/obras/ln/instpecam.jpg';
import instpecamL from '../assets/obras/ln/instpecam-dibujo.jpg';
import mirador from '../assets/obras/ln/mirador.jpg';
import miradorL from '../assets/obras/ln/mirador-dibujo.jpg';
import casd from '../assets/obras/ln/casd.jpg';
import casdL from '../assets/obras/ln/casd-dibujo.jpg';
import alfonso from '../assets/obras/ln/alfonso-lopez.jpg';
import alfonsoL from '../assets/obras/ln/alfonso-lopez-dibujo.jpg';
import jose from '../assets/obras/ln/jose-eugenio.jpg';
import joseL from '../assets/obras/ln/jose-eugenio-dibujo.jpg';
import coliseo from '../assets/obras/ln/coliseo.jpg';
import coliseoL from '../assets/obras/ln/coliseo-dibujo.jpg';

type Estado = 'c' | 'o' | 'd';
const estados: Record<Estado, string> = { c: 'Construido', o: 'En construcción', d: 'Diseñado' };
const colegio = 'Colegio en claustro de tres pisos: rediseñamos espacios interiores, fachadas, plazas, canchas y cafetería.';

const obras: { id: string; name: string; short: string; city: string; year: number; m2: string; st: Estado; render?: boolean; what: string; photo: ImageMetadata; line: ImageMetadata; pos?: string }[] = [
  { id: 'instpecam', name: 'I.E. Instpecam', short: 'Instpecam', city: 'Valledupar', year: 2022, m2: '15.097', st: 'c', what: colegio, photo: instpecam, line: instpecamL },
  { id: 'mirador', name: 'Mirador al Santo Ecce Homo', short: 'Mirador Ecce Homo', city: 'Valledupar', year: 2023, m2: '1.988', st: 'c', what: 'Terminamos una obra abandonada en obra gris desde 2008: diseño arquitectónico y ornamental del mirador.', photo: mirador, line: miradorL, pos: '62% 30%' },
  { id: 'casd', name: 'I.E. CASD', short: 'CASD', city: 'Valledupar', year: 2022, m2: '15.097', st: 'c', what: colegio, photo: casd, line: casdL },
  { id: 'alfonso', name: 'I.E. Alfonso López Pumarejo', short: 'Alfonso López Pumarejo', city: 'Valledupar', year: 2022, m2: '15.097', st: 'c', what: colegio, photo: alfonso, line: alfonsoL },
  { id: 'jose', name: 'I.E. José Eugenio Martínez', short: 'José Eugenio Martínez', city: 'Valledupar', year: 2024, m2: '15.097', st: 'o', what: colegio, photo: jose, line: joseL },
  { id: 'coliseo', name: 'Coliseo de Tenis de Mesa', short: 'Coliseo de tenis de mesa', city: 'Valledupar', year: 2025, m2: '8.959', st: 'o', render: true, what: 'Una caja de cristal para entrenar y competir con las reglas nacionales e internacionales.', photo: coliseo, line: coliseoL },
];
const built = obras.filter((o) => o.st === 'c').length;
const inWork = obras.filter((o) => o.st === 'o').length;
// k: escala de cada logo para que todos pesen lo mismo (los alargados van más bajos que los sellos redondos)
const clientes = [
  { src: gobernacion, name: 'Gobernación del Cesar', k: 1 },
  { src: alcaldia, name: 'Alcaldía de Valledupar', k: 0.72 },
  { src: corpocesar, name: 'Corpocesar', k: 0.56 },
  { src: codazzi, name: 'Alcaldía de Agustín Codazzi', k: 0.66 },
  { src: jagua, name: 'Municipio de La Jagua del Pilar', k: 1 },
  { src: urumita, name: 'Alcaldía de Urumita', k: 1.05 },
  { src: elbanco, name: 'Alcaldía de El Banco, Magdalena', k: 0.62 },
  { src: aconstruir, name: 'A Construir S.A.', k: 0.88 },
  { src: hrs, name: 'HRS Ingeniería', k: 0.5 },
];
const words = ['cero', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete'];
const pad = (i: number) => String(i + 1).padStart(2, '0');
const sizes = '(min-width: 1024px) 880px, 100vw';
// Las fotos grandes se piden por JS cuando la sección se acerca (no compiten con la carga del héroe)
const pics = await Promise.all(
  obras.map(async (o) => {
    const opts = { widths: [640, 960, 1280, 1600], format: 'webp' as const };
    const [ph, ln] = await Promise.all([getImage({ src: o.photo, ...opts, quality: 72 }), getImage({ src: o.line, ...opts, quality: 62 })]);
    return { ph: { src: ph.src, set: ph.srcSet.attribute }, ln: { src: ln.src, set: ln.srcSet.attribute } };
  }),
);
---

<section class="ob" id="proyectos" data-nav-label="Proyectos" aria-labelledby="ob-title" data-ob>
  <Trazos left="ejes" right="cota" />
  <div class="ob-in">
    <Plomada n="04" label="Proyectos" variant="obra" />
    <header class="ob-head ob-rv">
      <h2 id="ob-title" class="ob-h2">Lo que dibujamos <span class="accent">se construye</span></h2>
      <p class="ob-sub">{words[obras.length][0].toUpperCase() + words[obras.length].slice(1)} proyectos de obra pública en el Cesar: {words[built]} construidos y {words[inWork]} en obra.</p>
    </header>

    <div class="ob-body">
      <!-- Pantalla: el dibujo se vuelve obra detrás de la línea -->
      <div class="stage is-idle ob-rv" data-ob-stage>
        {
          obras.map((o, i) => (
            <figure class:list={['slide', { 'is-on': i === 0 }]} data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="kb">
                <img data-src={pics[i].ph.src} data-srcset={pics[i].ph.set} sizes={sizes} alt={`${o.name}, ${o.city}${o.render ? ' (render)' : ''}`} width={o.photo.width} height={o.photo.height} decoding="async" class="ph" style={o.pos && `object-position:${o.pos}`} />
              </div>
              <div class="cut" data-cut>
                <div class="cut-in" data-cut-in>
                  <div class="kb">
                    <img data-src={pics[i].ln.src} data-srcset={pics[i].ln.set} sizes={sizes} alt="" width={o.line.width} height={o.line.height} decoding="async" class="ph" style={o.pos && `object-position:${o.pos}`} />
                  </div>
                </div>
              </div>
            </figure>
          ))
        }
        <noscript><img src={pics[0].ph.src} srcset={pics[0].ph.set} sizes={sizes} alt={obras[0].name} class="ph-ns" /></noscript>
        <span class="scrim" aria-hidden="true"></span>

        <div class="rule" data-rule>
          <span class="rule-glow" aria-hidden="true"></span>
          <span class="rule-ticks" aria-hidden="true"></span>
          <span class="rule-tag rule-a" data-tag-a>{obras[0].render ? 'render' : 'obra'}</span>
          <span class="rule-tag rule-b">dibujo</span>
          <button type="button" class="knob" role="slider" aria-label="Comparar dibujo y obra" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-knob>
            <svg class="kn-chev kn-l" viewBox="0 0 8 14" aria-hidden="true"><path d="M7 1 1 7l6 6"></path></svg>
            <span class="kn-tile" aria-hidden="true">
              <svg class="kn-mono" viewBox="0 0 1647 1914"><path transform="matrix(1 0 0 -1 0 1914)" d={mono.trim()}></path></svg>
            </span>
            <svg class="kn-chev kn-r" viewBox="0 0 8 14" aria-hidden="true"><path d="M1 1l6 6-6 6"></path></svg>
          </button>
        </div>

        <!-- Ficha sobre la imagen -->
        <div class="fichas" aria-live="polite">
          {
            obras.map((o, i) => (
              <div class:list={['fi', { 'is-on': i === 0 }]} data-fi={i} aria-hidden={i === 0 ? 'false' : 'true'}>
                <p class="fi-meta"><span class="fi-n">{pad(i)}</span> {o.city} · {o.year}</p>
                <h3 class="fi-t">{o.name}</h3>
                <p class="fi-d">
                  <span class={`st st-${o.st}`}>{estados[o.st]}</span>
                  <span>{o.m2} m²<span class="lg"> de intervención</span></span>
                </p>
                <p class="fi-w">{o.what}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Tira de obras + botón -->
      <div class="side ob-rv">
        <ol class="strip" role="list" aria-label="Obras" data-strip>
          {
            obras.map((o, i) => (
              <li>
                <button type="button" class:list={['ch', { 'is-on': i === 0 }]} aria-current={i === 0 ? 'true' : undefined} aria-label={`${o.name}, ${o.city}`} data-ob-pick={i}>
                  <span class="ch-th">
                    <Image src={o.photo} alt="" widths={[96, 160]} sizes="80px" quality={60} loading="lazy" style={o.pos && `object-position:${o.pos}`} />
                    <span class="ch-n">{pad(i)}</span>
                  </span>
                  <span class="ch-tx">
                    <span class="ch-t">{o.short}</span>
                    <span class="ch-m">
                      {o.city !== 'Valledupar' ? o.city : o.year} · <span class={`ch-s st-${o.st}`}>{estados[o.st]}</span>
                    </span>
                  </span>
                  <span class="ch-bar" aria-hidden="true"><i /></span>
                </button>
              </li>
            ))
          }
        </ol>

        <div class="ob-actions">
          <a href="#cotizar" class="btn btn-primary chamfer" data-open-chat data-cta="obras">
            Cotiza tu diseño
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
          </a>
          <p class="ob-note">El mismo rigor de una obra pública, para tu proyecto.</p>
        </div>
      </div>
    </div>

    <!-- Nuestros clientes. Computador y tableta: cuadrícula; cada sello entra como un sello sobre la lámina
         (las marcas de corte se cierran, el logo cae, un anillo de tinta y una luz lo recorre).
         Celular: una cinta que corre sola, para que los siete quepan sin alargar la página. -->
    <div class="ob-clients-row" data-cl>
      <div class="cl-side">
        <p class="cl-stat"><span class="cl-num">+<span data-cl-count="70">70</span></span><span class="cl-what">proyectos diseñados</span></p>
        <p class="cl-l">Nuestros <span class="accent">clientes</span></p>
      </div>
      <ul class="ob-clients cl-grid" aria-label="Nuestros clientes">
        {
          clientes.map((c, i) => (
            <li class="cl-card" style={`--i:${i};--k:${c.k}`}>
              <span class="cl-mk mk-tl" aria-hidden="true" />
              <span class="cl-mk mk-tr" aria-hidden="true" />
              <span class="cl-mk mk-bl" aria-hidden="true" />
              <span class="cl-mk mk-br" aria-hidden="true" />
              <span class="cl-seal">
                <span class="cl-ring" aria-hidden="true" />
                <Image src={c.src} alt={c.name} height={220} densities={[1]} loading="lazy" />
                <span class="cl-shine" aria-hidden="true" />
              </span>
              <span class="cl-name">{c.name}</span>
            </li>
          ))
        }
      </ul>
      <div class="cl-marquee">
        <div class="cl-track">
          {
            [0, 1].map((copy) => (
              <ul class="ob-clients cl-run" aria-label={copy ? undefined : 'Nuestros clientes'} aria-hidden={copy ? 'true' : undefined}>
                {clientes.map((c) => (
                  <li class="cl-card" style={`--k:${c.k}`}>
                    <span class="cl-mk mk-tl" aria-hidden="true" />
                    <span class="cl-mk mk-tr" aria-hidden="true" />
                    <span class="cl-mk mk-bl" aria-hidden="true" />
                    <span class="cl-mk mk-br" aria-hidden="true" />
                    <span class="cl-seal">
                      <Image src={c.src} alt={copy ? '' : c.name} height={160} densities={[1]} loading="lazy" />
                    </span>
                    <span class="cl-name">{c.name}</span>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ob {
    --hdr: 76px;
    --pad: 20px;
    --cycle: 7000ms;
    position: relative;
    background: #fff;
    padding: calc(var(--hdr) + 8px) var(--pad) 8px;
    min-height: 100svh;
    display: flex;
    overflow: hidden;
  }
  .ob-in { position: relative; z-index: 1; width: 100%; max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  .ob-in > * { flex-shrink: 0; }
  .ob-head { margin-top: auto; text-align: center; display: grid; justify-items: center; gap: 6px; }
  .ob-body { margin-bottom: auto; display: flex; flex-direction: column; gap: 12px; }
  .ob-h2 { font-size: clamp(1.9rem, min(1.3rem + 2.6vw, 6svh), 3.6rem); line-height: 1.02; font-weight: 560; letter-spacing: -0.038em; text-wrap: balance; }
  .ob-h2 .accent { color: var(--color-brand); font-size: 1.08em; letter-spacing: -0.012em; }
  .ob-sub { max-width: 34rem; font-size: 0.95rem; line-height: 1.45; color: var(--color-ink-soft); text-wrap: balance; }
  /* ---------- Nuestros clientes ---------- */
  .ob-clients-row { margin-top: 30px; padding: 26px 0 22px; border-top: 1px solid var(--color-line); display: grid; justify-items: center; gap: 22px; min-width: 0; }
  .cl-side { display: grid; justify-items: center; gap: 18px; text-align: center; }
  /* La cifra: grande, en cursiva azul; cuenta de 0 a 70 al aparecer */
  .cl-stat { display: grid; justify-items: center; line-height: 1; }
  .cl-num { font-family: var(--font-serif); font-style: italic; font-size: clamp(4rem, 3rem + 4vw, 6.2rem); letter-spacing: -0.03em; color: var(--color-brand); font-variant-numeric: tabular-nums; }
  .cl-what { margin-top: 4px; font-size: 15px; font-weight: 600; color: var(--color-ink); }
  .cl-l { font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem); font-weight: 560; letter-spacing: -0.03em; }
  .cl-l .accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; color: var(--color-brand); font-size: 1.08em; }

  /* La tarjeta: papel, marcas de corte azules en las esquinas y el sello al centro.
     Cada logo trae su escala (--k) para que todos pesen lo mismo a la vista, sean redondos o alargados. */
  .cl-card { --s: 64px; position: relative; display: grid; justify-items: center; align-content: center; gap: 12px; padding: 22px 12px 16px; background: linear-gradient(180deg, #fff, #f8f6f2); box-shadow: inset 0 0 0 1px rgb(11 13 16 / 0.05), 0 16px 32px -26px rgb(0 60 100 / 0.35); transition: transform 0.6s var(--ease-out-expo), box-shadow 0.6s var(--ease-out-expo); }
  .cl-mk { position: absolute; width: 14px; height: 14px; border: 0 solid var(--color-brand); transition: transform 0.6s var(--ease-out-expo); }
  .mk-tl { top: 0; left: 0; border-top-width: 1.5px; border-left-width: 1.5px; }
  .mk-tr { top: 0; right: 0; border-top-width: 1.5px; border-right-width: 1.5px; }
  .mk-bl { bottom: 0; left: 0; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .mk-br { bottom: 0; right: 0; border-bottom-width: 1.5px; border-right-width: 1.5px; }
  .cl-seal { position: relative; display: grid; place-items: center; width: 100%; height: calc(var(--s) + 8px); overflow: hidden; }
  .cl-seal img { position: relative; display: block; width: auto; height: calc(var(--s) * var(--k)); max-width: 92%; object-fit: contain; }
  .cl-ring { position: absolute; left: 50%; top: 50%; width: 110px; height: 110px; margin: -55px 0 0 -55px; border-radius: 50%; border: 1.5px solid var(--color-brand); opacity: 0; }
  .cl-shine { position: absolute; inset: -10% auto -10% 0; width: 45%; background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.75) 50%, transparent); transform: translateX(-160%) skewX(-12deg); pointer-events: none; }
  .cl-name { font-size: 11.5px; line-height: 1.3; font-weight: 600; color: var(--color-ink-mute); text-align: center; text-wrap: balance; min-height: 2.6em; display: grid; place-items: center; }

  /* ----- Celular: la cinta ----- */
  .cl-grid { display: none; }
  .cl-marquee { width: calc(100% + 2 * var(--pad)); margin: 0 calc(-1 * var(--pad)); overflow: hidden; padding: 6px 0 20px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent); mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent); }
  .cl-track { display: flex; width: max-content; animation: cl-run 42s linear infinite; animation-play-state: paused; }
  .cl-run { display: flex; gap: 12px; padding-right: 12px; }
  .cl-run .cl-card { width: 158px; }
  .is-run .cl-track { animation-play-state: running; }
  .cl-marquee:active .cl-track { animation-play-state: paused; }
  @keyframes cl-run { to { transform: translateX(-50%); } }
  :global(html.js) .cl-marquee { opacity: 0; transform: translateX(24px); }
  .is-in .cl-marquee { opacity: 1; transform: none; transition: opacity 0.8s 0.2s, transform 1.1s var(--ease-out-expo) 0.2s; }

  /* Entrada de la cifra y el título */
  :global(html.js) .cl-l, :global(html.js) .cl-stat { opacity: 0; transform: translateY(12px); }
  .is-in .cl-stat { opacity: 1; transform: none; transition: opacity 0.6s, transform 0.8s var(--ease-out-expo); }
  .is-in .cl-l { opacity: 1; transform: none; transition: opacity 0.6s 0.12s, transform 0.8s var(--ease-out-expo) 0.12s; }

  /* ----- Tableta y computador: la cuadrícula con el sello ----- */
  @media (min-width: 640px) {
    .cl-marquee { display: none; }
    .cl-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; width: 100%; max-width: 860px; }
    .cl-grid .cl-card { --s: 70px; flex: 0 0 calc((100% - 2 * 16px) / 3); padding: 26px 14px 16px; }

    :global(html.js) .cl-grid .cl-card { opacity: 0; transform: translateY(18px); }
    :global(html.js) .cl-grid .cl-mk { opacity: 0; }
    :global(html.js) .cl-grid .mk-tl { transform: translate(-10px, -10px); }
    :global(html.js) .cl-grid .mk-tr { transform: translate(10px, -10px); }
    :global(html.js) .cl-grid .mk-bl { transform: translate(-10px, 10px); }
    :global(html.js) .cl-grid .mk-br { transform: translate(10px, 10px); }
    :global(html.js) .cl-grid .cl-seal img { opacity: 0; transform: scale(1.35); }
    :global(html.js) .cl-grid .cl-name { opacity: 0; }
    .is-in .cl-grid .cl-card { opacity: 1; transform: none; transition: opacity 0.6s calc(0.15s + var(--i) * 0.12s), transform 0.9s var(--ease-out-expo) calc(0.15s + var(--i) * 0.12s), box-shadow 0.6s var(--ease-out-expo); }
    .is-in .cl-grid .cl-mk { opacity: 1; transform: none; transition: opacity 0.4s calc(0.35s + var(--i) * 0.12s), transform 0.8s var(--ease-out-expo) calc(0.35s + var(--i) * 0.12s); }
    .is-in .cl-grid .cl-seal img { animation: cl-stamp 0.7s cubic-bezier(0.3, 1.5, 0.5, 1) calc(0.6s + var(--i) * 0.12s) both; }
    .is-in .cl-grid .cl-ring { animation: cl-ring 0.9s var(--ease-out-expo) calc(0.82s + var(--i) * 0.12s) forwards; }
    .is-in .cl-grid .cl-shine { animation: cl-shine 1.1s cubic-bezier(0.45, 0, 0.2, 1) calc(1.15s + var(--i) * 0.12s) both; }
    .is-in .cl-grid .cl-name { opacity: 1; transition: opacity 0.6s calc(0.95s + var(--i) * 0.12s); }
  }
  @keyframes cl-stamp {
    0% { opacity: 0; transform: scale(1.35); }
    55% { opacity: 1; transform: scale(0.94); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes cl-ring {
    0% { opacity: 0.55; transform: scale(0.5); }
    100% { opacity: 0; transform: scale(1.5); }
  }
  @keyframes cl-shine { to { transform: translateX(330%) skewX(-12deg); } }

  /* Con mouse: la tarjeta se levanta, las marcas se abren y la luz vuelve a pasar */
  @media (hover: hover) and (pointer: fine) and (min-width: 640px) {
    .is-in .cl-grid .cl-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -22px rgb(0 60 100 / 0.35); }
    .is-in .cl-grid .cl-card:hover .mk-tl { transform: translate(-5px, -5px); }
    .is-in .cl-grid .cl-card:hover .mk-tr { transform: translate(5px, -5px); }
    .is-in .cl-grid .cl-card:hover .mk-bl { transform: translate(-5px, 5px); }
    .is-in .cl-grid .cl-card:hover .mk-br { transform: translate(5px, 5px); }
    .is-in .cl-grid .cl-card:hover .cl-shine { animation: cl-shine2 0.9s cubic-bezier(0.45, 0, 0.2, 1); }
  }
  @keyframes cl-shine2 { from { transform: translateX(-160%) skewX(-12deg); } to { transform: translateX(330%) skewX(-12deg); } }

  @media (min-width: 1024px) {
    .ob-clients-row { margin-top: clamp(36px, 6svh, 64px); padding-top: 36px; grid-template-columns: auto minmax(0, 960px); justify-content: center; align-items: center; column-gap: 56px; }
    .cl-side { justify-items: start; text-align: left; gap: 14px; padding-right: 56px; border-right: 1px solid var(--color-line); }
    .cl-stat { justify-items: start; }
    .cl-grid { max-width: none; }
    .cl-grid .cl-card { --s: 72px; flex-basis: calc((100% - 4 * 16px) / 5); padding: 28px 12px 16px; }
    .cl-grid { gap: 16px; }
  }
  :global(html.rm) .ob-clients-row * { animation: none !important; transition: none !important; opacity: 1 !important; transform: none !important; }
  :global(html.rm) .cl-ring, :global(html.rm) .cl-shine { opacity: 0 !important; }
  :global(html.rm) .cl-marquee { overflow-x: auto; }

  /* ---------- Pantalla ---------- */
  .stage {
    --corner: 18px;
    position: relative;
    margin: 0 calc(var(--pad) * -1);
    height: clamp(210px, calc(100svh - 444px), 118vw);
    background: #f6f3ed;
    overflow: hidden;
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    isolation: isolate;
  }
  /* Cortes a 45° con esquinas sólidas (no clip-path: las capas animadas se escapan del recorte en Chrome) */
  .stage::before,
  .stage::after { content: ''; position: absolute; z-index: 9; width: var(--corner); height: var(--corner); pointer-events: none; }
  .stage::before { left: 0; top: 0; background: linear-gradient(135deg, #fff 50%, transparent 50.5%); }
  .stage::after { right: 0; bottom: 0; background: linear-gradient(-45deg, #fff 50%, transparent 50.5%); }

  .ph-ns { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; object-fit: cover; }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 0.45s var(--ease-out-expo); }
  .slide.is-on { opacity: 1; z-index: 2; }
  .slide.is-prev { opacity: 1; z-index: 1; transition: none; }
  .kb { position: absolute; inset: 0; transform-origin: 50% 60%; }
  .slide :global(.ph) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; -webkit-user-drag: none; }
  /* Acercamiento lento de cine: foto y dibujo a la vez, siempre alineados */
  :global(html.js:not(.rm)) .slide.is-on .kb,
  :global(html.js:not(.rm)) .slide.is-prev .kb { animation: ob-kb 7s cubic-bezier(0.2, 0.6, 0.3, 1) forwards; }
  @keyframes ob-kb { from { transform: scale(1); } to { transform: scale(1.08); } }

  /* El dibujo vive a la derecha de la línea: el marco se corre y su contenido se corre al revés (solo transform) */
  .cut, .cut-in { position: absolute; inset: 0; overflow: hidden; will-change: transform; }
  /* Sin JS: se ve la foto con una franja de dibujo */
  .cut { transform: translate3d(80%, 0, 0); }
  .cut-in { transform: translate3d(-80%, 0, 0); }

  /* Degradado para leer la ficha sobre la imagen */
  .scrim { position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; height: 62%; background: linear-gradient(180deg, rgb(8 14 22 / 0) 0, rgb(8 14 22 / 0.38) 45%, rgb(8 14 22 / 0.78) 100%); pointer-events: none; }

  /* ---------- Línea de obra con luz ---------- */
  .rule { position: absolute; inset: 0; z-index: 4; pointer-events: none; transform: translate3d(80%, 0, 0); will-change: transform; }
  .rule::before { content: ''; position: absolute; left: -1px; top: 0; bottom: 0; width: 2px; background: #fff; box-shadow: 0 0 0 1px rgb(0 128 193 / 0.9), 0 0 18px 2px rgb(0 128 193 / 0.55); }
  /* Haz de luz que barre sobre el dibujo mientras la obra se construye */
  .rule-glow {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: clamp(70px, 14vw, 180px);
    background: linear-gradient(90deg, rgb(0 128 193 / 0.3), rgb(0 128 193 / 0.1) 40%, rgb(0 128 193 / 0));
    opacity: 0.35;
    transition: opacity 0.6s;
  }
  .stage.is-sweeping .rule-glow { opacity: 1; }
  /* Escala de la línea: marcas de regla cada 14 px y mayores cada 70 px, como un escalímetro */
  .rule-ticks {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -7px;
    width: 14px;
    pointer-events: none;
    background:
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.95) 0 1.5px, transparent 1.5px 70px) center / 14px 100% no-repeat,
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.7) 0 1px, transparent 1px 14px) center / 7px 100% no-repeat;
    opacity: 0.85;
  }
  /* Perilla: el monograma de Galezo en su bloque con corte a 45°, con flechas que invitan a arrastrar */
  .knob {
    position: absolute;
    left: 0;
    top: 42%;
    width: 96px;
    height: 56px;
    translate: -50% -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0;
    border: 0;
    background: none;
    pointer-events: auto;
    cursor: ew-resize;
    filter: drop-shadow(0 8px 16px rgb(0 30 55 / 0.45));
    transition: scale 0.35s var(--ease-out-expo);
  }
  .kn-tile {
    --c: 12px;
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: var(--color-brand-ink);
    clip-path: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
    transition: background-color 0.35s;
  }
  /* filo blanco interior que sigue el corte */
  .kn-tile::before {
    content: '';
    position: absolute;
    inset: 3px;
    --c: 10px;
    clip-path: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0) 55%);
  }
  .kn-mono { position: relative; width: 24px; height: auto; fill: #fff; transition: transform 0.6s var(--ease-out-expo); }
  .kn-chev { width: 8px; height: 14px; fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 1.5px rgb(4 20 34 / 0.9)) drop-shadow(0 0 4px rgb(4 20 34 / 0.5)); }
  /* mientras nadie la toca, las flechas se asoman hacia los lados */
  .stage.is-idle .kn-l { animation: ob-nudge-l 2.4s ease-in-out infinite; }
  .stage.is-idle .kn-r { animation: ob-nudge-r 2.4s ease-in-out infinite; }
  @keyframes ob-nudge-l { 0%, 60%, 100% { transform: none; } 30% { transform: translateX(-4px); } }
  @keyframes ob-nudge-r { 0%, 60%, 100% { transform: none; } 30% { transform: translateX(4px); } }
  /* al barrer, el monograma gira un cuarto de vuelta en el sentido de la línea; al arrastrar, el bloque se ilumina */
  .stage.is-sweeping .kn-mono { transform: rotate(-90deg) scale(0.92); }
  .stage.is-dragging .kn-tile, .knob:hover .kn-tile { background: var(--color-brand); }
  .stage:hover .knob, .knob:focus-visible { scale: 1.06; }
  .knob:focus-visible { outline: none; }
  .knob:focus-visible .kn-tile { background: var(--color-brand); }
  :global(html.rm) .kn-chev { animation: none !important; }
  .rule-tag {
    position: absolute;
    top: 14px;
    padding: 5px 10px 6px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: #fff;
    background: rgb(8 14 22 / 0.5);
  }
  .rule-a { right: 100%; margin-right: 12px; }
  .rule-b { left: 12px; color: var(--color-ink); background: rgb(255 255 255 / 0.9); }

  /* ---------- Ficha sobre la imagen ---------- */
  .fichas { position: absolute; z-index: 5; left: 0; right: 0; bottom: 0; display: grid; padding: 0 var(--pad) 16px; pointer-events: none; color: #fff; }
  .fi { grid-area: 1 / 1; align-self: end; max-width: 34rem; opacity: 0; transform: translateY(10px); transition: opacity 0.4s, transform 0.6s var(--ease-out-expo); }
  .fi.is-on { opacity: 1; transform: none; transition-delay: 0.08s; }
  .fi-meta { font-size: 12.5px; color: rgb(255 255 255 / 0.78); text-shadow: 0 1px 8px rgb(0 0 0 / 0.3); }
  .fi-n { font-family: var(--font-serif); font-style: italic; font-size: 16px; color: #9fd3f0; margin-right: 3px; }
  .fi-t { margin-top: 1px; font-size: clamp(1.25rem, 1rem + 1.6vw, 2.4rem); font-weight: 600; letter-spacing: -0.032em; line-height: 1.06; text-wrap: balance; text-shadow: 0 2px 18px rgb(0 0 0 / 0.25); }
  .fi-d { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 13px; color: rgb(255 255 255 / 0.88); font-variant-numeric: tabular-nums; }
  .fi-w { display: none; margin-top: 8px; font-size: 14.5px; line-height: 1.45; color: rgb(255 255 255 / 0.86); text-wrap: pretty; }
  .st { --cut: 5px; display: inline-block; padding: 4px 9px 5px; font-size: 12px; font-weight: 600; line-height: 1; clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); }
  .st.st-c { background: var(--color-brand); color: #fff; }
  .st.st-o { background: #fff; color: var(--color-brand-ink); }
  .st.st-d { background: rgb(255 255 255 / 0.22); color: #fff; }
  .fi-d .lg { display: none; }

  /* ---------- Tira de obras (como historias): las siete a la vista ---------- */
  .side { display: flex; flex-direction: column; gap: 12px; }
  .strip { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
  .ch { position: relative; display: block; width: 100%; padding: 0 0 7px; border: 0; background: none; cursor: pointer; text-align: left; font: inherit; color: inherit; }
  .ch-th { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: #eee; transition: opacity 0.35s, transform 0.5s var(--ease-out-expo); }
  .ch-th :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out-expo); }
  .ch-n { position: absolute; left: 4px; bottom: 2px; font-family: var(--font-serif); font-style: italic; font-size: 13px; color: #fff; text-shadow: 0 1px 6px rgb(0 0 0 / 0.6); }
  .ch-tx { display: none; }
  .strip.has-on .ch:not(.is-on) .ch-th { opacity: 0.55; }
  .ch:hover .ch-th { opacity: 1; }
  .ch:hover .ch-th :global(img) { transform: scale(1.06); }
  .ch.is-on .ch-th { box-shadow: inset 0 0 0 2px var(--color-brand); }
  .ch:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  /* Barra de avance: se llena mientras corre la obra; si la persona toma el control, queda llena */
  .ch-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #e7e4de; overflow: hidden; }
  .ch-bar i { display: block; height: 100%; background: var(--color-brand); transform-origin: 0 50%; transform: scaleX(0); }
  .ch.is-on .ch-bar i { transform: scaleX(1); }
  .strip.is-auto .ch.is-on .ch-bar i { animation: ob-fill var(--cycle) linear both; }
  @keyframes ob-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* ---------- Botón ---------- */
  .ob-actions { display: flex; align-items: center; gap: 10px 16px; }
  .btn { --cut: 9px; display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 22px; font-size: 15px; font-weight: 560; white-space: nowrap; }
  .btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.45s var(--ease-out-expo); }
  .btn-primary { background: var(--color-brand-ink); color: #fff; transition: background-color 0.3s var(--ease-out-expo); }
  .btn-primary:hover { background: var(--color-ink); }
  .btn-primary:hover svg { transform: translateX(3px); }
  .ob-note { font-size: 12.5px; line-height: 1.4; color: var(--color-ink-mute); text-wrap: balance; }

  /* Entradas */
  :global(html.js) .ob-rv { opacity: 0; transform: translateY(18px); transition: opacity 0.9s var(--ease-out-expo), transform 1s var(--ease-out-expo); }
  :global(html.js) .ob-rv.is-in { opacity: 1; transform: none; }
  :global(html.js) .stage.ob-rv { transition-delay: 0.1s; }
  :global(html.js) .side.ob-rv { transition-delay: 0.2s; }
  :global(html.rm) .ob-rv { opacity: 1 !important; transform: none !important; }

  @media (max-width: 360px) {
    .ob-sub { font-size: 0.88rem; }
    .stage { height: clamp(200px, calc(100svh - 430px), 118vw); }
    .ob-note { display: none; }
  }
  @media (min-width: 640px) {
    .ob { --pad: 28px; padding-bottom: 16px; }
    .stage { margin: 0; --corner: 22px; height: clamp(280px, calc(100svh - 460px), 70vw); }

    .fichas { padding: 0 26px 22px; }
    .fi-d .lg { display: inline; }
    .strip { gap: 8px; }
    .ch-th { aspect-ratio: 4 / 3; }
  }
  @media (min-width: 640px) and (min-height: 900px) {
    .fi-w { display: block; }
  }
  /* ---------- Escritorio: pantalla grande + lista de obras con miniatura al lado ---------- */
  @media (min-width: 1024px) {
    .ob {
      --pad: max(40px, calc((100% - 1200px) / 2));
      --hdr: 84px;
      padding: calc(var(--hdr) + clamp(14px, 3svh, 36px)) var(--pad) clamp(24px, 4svh, 48px);
    }
    .ob-in, .ob-body { gap: clamp(12px, 2.4svh, 28px); }
    .ob-sub { max-width: none; font-size: clamp(0.98rem, 0.92rem + 0.3vw, 1.12rem); }

    .ob-body { display: grid; grid-template-columns: minmax(0, 1fr) clamp(260px, 25vw, 300px); }
    .stage { height: clamp(320px, calc(100svh - var(--hdr) - 150px - 15svh), 640px); }
    .fichas { padding: 0 32px 28px; }
    .side { gap: 14px; height: clamp(320px, calc(100svh - var(--hdr) - 150px - 15svh), 640px); }
    .strip { flex: 1; min-height: 0; grid-template-columns: 1fr; grid-auto-rows: minmax(0, 1fr); gap: 4px; }
    .strip li { min-height: 0; }
    .ch { height: 100%; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 12px; padding: 0 0 4px; }
    .ch-th { height: 100%; max-height: 64px; aspect-ratio: 3 / 2; }
    .ch-n { font-size: 12px; }
    .ch-tx { display: grid; gap: 1px; min-width: 0; }
    .ch-t { font-size: 14px; font-weight: 600; letter-spacing: -0.012em; color: var(--color-ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color 0.3s; }
    .ch-m { font-size: 12px; color: var(--color-ink-mute); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ch-s.st-c { color: var(--color-brand-ink); font-weight: 560; }
    .ch.is-on .ch-t, .ch:hover .ch-t { color: var(--color-ink); }
    .ch.is-on .ch-th { box-shadow: none; }
    .ch-bar { height: 2px; }
    .strip.has-on .ch:not(.is-on) .ch-th { opacity: 0.6; }
    .ob-actions { flex-wrap: wrap; }
    .ob-note { flex: 1 1 100%; }
  }
  @media (min-width: 1024px) and (max-height: 800px) {
    .ob-note { display: none; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-ob]')!;
  const stage = sec.querySelector<HTMLElement>('[data-ob-stage]')!;
  const slides = [...sec.querySelectorAll<HTMLElement>('[data-slide]')].map((el) => ({
    el,
    cut: el.querySelector<HTMLElement>('[data-cut]')!,
    inner: el.querySelector<HTMLElement>('[data-cut-in]')!,
  }));
  const fichas = [...sec.querySelectorAll<HTMLElement>('[data-fi]')];
  const picks = [...sec.querySelectorAll<HTMLButtonElement>('[data-ob-pick]')];
  const strip = sec.querySelector<HTMLElement>('[data-strip]')!;
  const rule = sec.querySelector<HTMLElement>('[data-rule]')!;
  const knob = sec.querySelector<HTMLButtonElement>('[data-knob]')!;
  const tagA = sec.querySelector<HTMLElement>('[data-tag-a]')!;
  const renders = new Set([5, 6]);
  const reduced = document.documentElement.classList.contains('rm');
  const N = slides.length;
  const DELAY = 220;
  const SWEEP = 1500;
  const HOLD = 3000;
  sec.style.setProperty('--cycle', `${DELAY + SWEEP + HOLD}ms`);

  let cur = 0;
  let x = 0; // fracción ya construida (0 = todo dibujo, 1 = toda la foto)
  let auto = !reduced;
  let inView = false;
  let tween = 0;
  let timer = 0;
  let prevT = 0;

  const apply = () => {
    const s = slides[cur];
    const p = (x * 100).toFixed(3);
    s.cut.style.transform = `translate3d(${p}%,0,0)`;
    s.inner.style.transform = `translate3d(-${p}%,0,0)`;
    rule.style.transform = `translate3d(${p}%,0,0)`;
    knob.setAttribute('aria-valuenow', String(Math.round(x * 100)));
  };

  const stopTween = () => {
    cancelAnimationFrame(tween);
    tween = 0;
    stage.classList.remove('is-sweeping');
  };
  // La línea de obra avanza: dibujo → obra
  const sweep = (to: number, ms: number, done?: () => void) => {
    stopTween();
    stage.classList.add('is-sweeping');
    const from = x;
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / ms);
      const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
      x = from + (to - from) * e;
      apply();
      if (k < 1) tween = requestAnimationFrame(step);
      else {
        tween = 0;
        stage.classList.remove('is-sweeping');
        done?.();
      }
    };
    tween = requestAnimationFrame(step);
  };

  const REST = 0.8;
  const play = () => {
    clearTimeout(timer);
    if (reduced) {
      x = REST;
      apply();
      return;
    }
    sweep(REST, SWEEP, () => {
      if (auto && inView) timer = window.setTimeout(() => go((cur + 1) % N), HOLD);
    });
  };

  const restartBar = () => {
    strip.classList.remove('is-auto');
    if (!auto) return;
    void strip.offsetWidth;
    strip.classList.add('is-auto');
  };

  const go = (i: number) => {
    stopTween();
    clearTimeout(timer);
    const prev = cur;
    cur = (i + N) % N;
    fill(cur);
    x = 0; // la obra nueva entra como dibujo completo
    apply();
    // La anterior queda debajo, entera, mientras la nueva aparece encima
    slides.forEach((s, j) => {
      s.el.classList.toggle('is-on', j === cur);
      s.el.classList.toggle('is-prev', j === prev && prev !== cur);
      s.el.setAttribute('aria-hidden', String(j !== cur));
    });
    clearTimeout(prevT);
    prevT = window.setTimeout(() => slides[prev].el.classList.remove('is-prev'), 550);
    fichas.forEach((f, j) => {
      f.classList.toggle('is-on', j === cur);
      f.setAttribute('aria-hidden', String(j !== cur));
    });
    picks.forEach((r, j) => {
      r.classList.toggle('is-on', j === cur);
      if (j === cur) r.setAttribute('aria-current', 'true');
      else r.removeAttribute('aria-current');
    });
    tagA.textContent = renders.has(cur) ? 'render' : 'obra';
    restartBar();
    timer = window.setTimeout(play, DELAY);
  };

  const userTook = () => {
    auto = false;
    clearTimeout(timer);
    strip.classList.remove('is-auto');
    stage.classList.remove('is-idle');
  };

  // Arrastrar la línea. Mouse: de inmediato. Dedo: solo si el gesto es claramente horizontal;
  // un toque o un gesto vertical nunca mueve la línea y el scroll de la página sigue libre (touch-action: pan-y).
  let drag = false;
  let pend: { id: number; x: number; y: number } | null = null;
  const toX = (e: PointerEvent) => {
    const r = stage.getBoundingClientRect();
    x = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width));
    apply();
  };
  const startDrag = (e: PointerEvent) => {
    userTook();
    stopTween();
    drag = true;
    stage.classList.add('is-dragging');
    stage.setPointerCapture(e.pointerId);
    toX(e);
  };
  stage.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    if (e.pointerType === 'mouse') startDrag(e);
    else pend = { id: e.pointerId, x: e.clientX, y: e.clientY };
  });
  stage.addEventListener('pointermove', (e) => {
    if (drag) return toX(e);
    if (pend && e.pointerId === pend.id) {
      const dx = Math.abs(e.clientX - pend.x);
      const dy = Math.abs(e.clientY - pend.y);
      if (dx > 8 && dx > dy * 1.4) {
        pend = null;
        startDrag(e);
      } else if (dy > 10) pend = null;
    }
  });
  const end = () => {
    drag = false;
    stage.classList.remove('is-dragging');
    pend = null;
  };
  stage.addEventListener('pointerup', end);
  stage.addEventListener('pointercancel', end);

  knob.addEventListener('keydown', (e) => {
    const k = e.key;
    const d = k === 'ArrowRight' || k === 'ArrowUp' ? 0.05 : k === 'ArrowLeft' || k === 'ArrowDown' ? -0.05 : 0;
    if (!d && k !== 'Home' && k !== 'End') return;
    e.preventDefault();
    userTook();
    stopTween();
    x = k === 'Home' ? 0 : k === 'End' ? 1 : Math.max(0, Math.min(1, x + d));
    apply();
  });

  // Tira de obras: tocar, clic, teclado o pasar el mouse (con una pausa corta para no saltar al cruzar)
  let hov = 0;
  picks.forEach((r, i) => {
    r.addEventListener('click', () => {
      userTook();
      if (i !== cur) go(i);
    });
    r.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(hov);
      hov = window.setTimeout(() => {
        userTook();
        if (i !== cur) go(i);
      }, 160);
    });
    r.addEventListener('pointerleave', () => clearTimeout(hov));
  });

  apply();

  // Fotos: la primera obra cuando la sección se acerca; las demás después, en orden
  const fill = (j: number) => {
    for (const im of slides[j].el.querySelectorAll<HTMLImageElement>('img[data-src]')) {
      im.srcset = im.dataset.srcset!;
      im.src = im.dataset.src!;
      im.removeAttribute('data-src');
    }
  };
  const near = new IntersectionObserver(
    ([e]) => {
      if (!e.isIntersecting) return;
      near.disconnect();
      fill(0);
      let j = 1;
      const next = () => {
        if (j >= N) return;
        fill(j++);
        setTimeout(next, 250);
      };
      setTimeout(next, 600);
    },
    { rootMargin: '120% 0px' },
  );
  near.observe(sec);

  // Nuestros clientes: entra cuando la fila aparece (va debajo de la primera pantalla de la sección)
  const clients = sec.querySelector<HTMLElement>('[data-cl]');
  if (clients) {
    const cio = new IntersectionObserver(
      (es) => {
        const vis = es.some((e) => e.isIntersecting);
        clients.classList.toggle('is-run', vis);
        if (vis && !clients.classList.contains('is-in')) {
          clients.classList.add('is-in');
          // la cifra cuenta de 0 a su valor
          const num = clients.querySelector<HTMLElement>("[data-cl-count]");
          if (num && !document.documentElement.classList.contains('rm')) {
            const to = Number(num.dataset.clCount);
            const t0 = performance.now();
            const tick = (t: number) => {
              const k = Math.min(1, (t - t0) / 1600);
              num.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
              if (k < 1) requestAnimationFrame(tick);
            };
            num.textContent = '0';
            requestAnimationFrame(tick);
          }
        }
      },
      { threshold: 0.2 },
    );
    cio.observe(clients);
  }

  // Entrada: textos suben y la primera obra se construye
  let started = false;
  const io = new IntersectionObserver(
    (es) => {
      for (const e of es) {
        inView = e.isIntersecting;
        if (inView && !started) {
          started = true;
          sec.querySelectorAll('.ob-rv').forEach((el) => el.classList.add('is-in'));
          strip.classList.add('has-on');
          restartBar();
          timer = window.setTimeout(play, 400);
        } else if (inView && auto && !tween) {
          timer = window.setTimeout(() => go((cur + 1) % N), 800);
        } else if (!inView) {
          clearTimeout(timer);
        }
      }
    },
    { threshold: 0.35 },
  );
  io.observe(sec);
</script>
