---
/**
 * Remodelación · 03 "También para locales y espacios públicos": interiores que reciben gente, con renders reales de
 * Ulises (baños y Hall de la Fama del CCMV, sala del Museo de Juglares). Estado según el portafolio final: CCMV
 * diseñado y construido (A Construir, 2025); Museo de Juglares diseñado (Urumita, 2021).
 * Recurso propio: un mosaico editorial (una imagen grande y cuatro chicas) con el rótulo de cada espacio.
 * Celular: una fila que se desliza con el dedo, con la siguiente asomando, y el contador de imágenes.
 */
import LazyImg from '../LazyImg.astro';
import Plomada from '../Plomada.astro';
import Trazos from '../Trazos.astro';
import bano1 from '../../assets/remodelacion/ccmv-bano-1.jpg';
import bano2 from '../../assets/remodelacion/ccmv-bano-2.jpg';
import hall1 from '../../assets/remodelacion/ccmv-hall-1.jpg';
import hall2 from '../../assets/remodelacion/ccmv-hall-2.jpg';
import museo from '../../assets/remodelacion/museo-juglares.jpg';

const { n = '03' } = Astro.props as { n?: string };
const piezas = [
  { p: 'CCMV', e: 'Baños públicos', src: bano1, alt: 'Baños del CCMV: lavamanos en piedra, espejos con luz, muro verde y banca de espera', pos: '50% 50%' },
  { p: 'CCMV', e: 'Hall de la Fama', src: hall1, alt: 'Hall de la Fama del CCMV: corredor con piso ajedrezado, celosía y figuras de juglares', pos: '50% 55%' },
  { p: 'CCMV', e: 'Baños públicos', src: bano2, alt: 'Baños del CCMV: piso en baldosa blanco y negro, techo en madera, lámparas tejidas y versos en el muro', pos: '50% 50%' },
  { p: 'Museo de Juglares', e: 'Sala de exhibición', src: museo, alt: 'Sala del Museo de Juglares con techo en listones de madera y piezas en exhibición', pos: '40% 50%' },
  { p: 'CCMV', e: 'Hall de la Fama', src: hall2, alt: 'Hall de la Fama del CCMV: pasillo de paneles azules con fotos y nombres de los grandes del vallenato', pos: '50% 50%' },
];
---

<section class="pb" id="espacios-publicos" data-nav-label="Locales y espacios públicos" aria-labelledby="pb-title" data-pb>
  <Trazos left="sube" right="nivel" />
  <div class="pb-in">
    <Plomada n={n} label="Espacios públicos" variant="sello" />
    <header class="pb-head pb-rv">
      <h2 id="pb-title" class="pb-h2">También para <span class="accent">locales y espacios públicos</span></h2>
      <p class="pb-sub">Baños, salas y lugares de exhibición pensados por dentro, para mucha gente y para durar.</p>
    </header>

    <ul class="mos pb-rv" role="list" data-mos>
      {
        piezas.map((x, i) => (
          <li class={`tile t${i + 1}`} style={`--i:${i}`}>
            <figure class="tile-f chamfer">
              <LazyImg src={x.src} alt={x.alt} widths={[480, 760, 1100, 1500]} sizes={i === 0 ? '(min-width: 1024px) 600px, 84vw' : '(min-width: 1024px) 300px, 84vw'} class="tile-img" style={`object-position:${x.pos}`} />
              <figcaption class="tile-c">
                <span class="tile-p">{x.p}</span>
                <span class="tile-e">{x.e}</span>
              </figcaption>
              <span class="tile-st">{x.p === 'CCMV' ? 'Diseñado y construido' : 'Diseñado'}</span>
            </figure>
          </li>
        ))
      }
    </ul>
    <p class="mos-count" aria-hidden="true"><span data-mos-n>1</span> / {piezas.length}</p>
  </div>
</section>

<style>
  .pb {
    --hdr: 76px;
    --pad: 20px;
    position: relative;
    background: #fff;
    padding: calc(var(--hdr) + 8px) var(--pad) 18px;
    min-height: 100svh;
    display: flex;
    overflow: hidden;
  }
  .pb-in { position: relative; z-index: 1; width: 100%; max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  .pb-head { margin-top: auto; display: grid; justify-items: center; text-align: center; gap: 6px; }
  .pb-h2 { font-size: clamp(1.9rem, min(1.3rem + 2.6vw, 6svh), 3.4rem); line-height: 1.02; font-weight: 560; letter-spacing: -0.038em; text-wrap: balance; max-width: 18ch; }
  .pb-h2 .accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.012em; color: var(--color-brand); font-size: 1.08em; }
  .pb-sub { max-width: 30rem; font-size: 0.95rem; line-height: 1.45; color: var(--color-ink-soft); text-wrap: balance; }

  /* ---------- Celular: una fila que se desliza, con la siguiente asomando ---------- */
  .mos { display: flex; gap: 12px; margin: 6px calc(var(--pad) * -1) 0; padding: 0 var(--pad) 6px; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .mos::-webkit-scrollbar { display: none; }
  .tile { flex: 0 0 84%; scroll-snap-align: center; }
  .mos-count { margin-bottom: auto; text-align: center; font-family: var(--font-serif); font-style: italic; font-size: 15px; color: var(--color-ink-mute); }
  .mos-count span { color: var(--color-brand); }
  .tile-f { --cut: 16px; position: relative; margin: 0; aspect-ratio: 1.3; overflow: hidden; background: #ece9e3; }
  .tile-f :global(.tile-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.1s var(--ease-out-expo), filter 0.6s; }
  /* rótulo: proyecto y espacio, sobre un degradado */
  .tile-f::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 55%; background: linear-gradient(180deg, rgb(8 14 22 / 0), rgb(8 14 22 / 0.72)); pointer-events: none; }
  .tile-c { position: absolute; z-index: 1; left: 14px; right: 14px; bottom: 12px; display: grid; color: #fff; line-height: 1.15; }
  .tile-p { font-size: 12px; font-weight: 600; color: rgb(255 255 255 / 0.8); }
  .tile-e { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.015em; text-shadow: 0 2px 12px rgb(0 0 0 / 0.3); }
  .tile-st { --cut: 5px; position: absolute; z-index: 1; top: 12px; left: 12px; padding: 4px 9px 5px; font-size: 11.5px; font-weight: 600; line-height: 1; color: var(--color-brand-ink); background: rgb(255 255 255 / 0.92); clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); }

  /* Entradas: las piezas se cuelgan una tras otra */
  :global(html.js) .pb-rv { opacity: 0; transform: translateY(18px); transition: opacity 0.9s var(--ease-out-expo), transform 1s var(--ease-out-expo); }
  :global(html.js) .pb.is-in .pb-rv { opacity: 1; transform: none; }
  :global(html.js) .pb .tile { opacity: 0; transform: translateY(16px); }
  :global(html.js) .pb.is-in .tile { opacity: 1; transform: none; transition: opacity 0.7s calc(0.15s + var(--i) * 0.09s), transform 0.9s var(--ease-out-expo) calc(0.15s + var(--i) * 0.09s); }
  :global(html.rm) .pb :is(.pb-rv, .tile) { opacity: 1 !important; transform: none !important; }
  :global(html.rm) .pb * { transition: none !important; }

  @media (max-width: 639px) and (max-height: 760px) {
    .pb-sub { display: none; }
  }
  @media (min-width: 640px) {
    .pb { --pad: 28px; }
    .tile { flex-basis: 62%; }
  }

  /* ---------- Escritorio: mosaico, una grande y cuatro chicas ---------- */
  @media (min-width: 1024px) {
    .pb { --pad: max(40px, calc((100% - 1200px) / 2)); --hdr: 84px; padding: calc(var(--hdr) + clamp(14px, 3svh, 36px)) var(--pad) clamp(24px, 4svh, 48px); }
    .pb-in { gap: clamp(14px, 2.6svh, 28px); }
    .mos { display: grid; grid-template-columns: 1.5fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; margin: 0 0 auto; padding: 0; overflow: visible; height: clamp(300px, calc(100svh - var(--hdr) - 335px), 600px); }
    .tile { min-height: 0; }
    .t1 { grid-row: 1 / 3; }
    .tile-f { aspect-ratio: auto; height: 100%; }
    .mos-count { display: none; }
    .tile-e { font-size: 1.1rem; }
    .t1 .tile-e { font-size: 1.5rem; }
    .t1 .tile-c { left: 20px; bottom: 18px; }
    /* con mouse: la imagen se aclara y el rótulo sube un poco */
    .tile-c { transition: transform 0.5s var(--ease-out-expo); }
    .tile:hover .tile-c { transform: translateY(-4px); }
    .tile:hover .tile-f :global(.tile-img) { filter: brightness(1.06) saturate(1.05); }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-pb]');
  if (sec) {
    const mos = sec.querySelector<HTMLElement>('[data-mos]')!;
    const num = sec.querySelector<HTMLElement>('[data-mos-n]')!;
    const tiles = [...mos.querySelectorAll<HTMLElement>('.tile')];
    // contador del carrusel en celular: la pieza que está más centrada
    mos.addEventListener('scroll', () => {
      const c = mos.scrollLeft + mos.clientWidth / 2;
      let best = 0, d = Infinity;
      tiles.forEach((t, i) => { const m = Math.abs(t.offsetLeft + t.offsetWidth / 2 - c); if (m < d) { d = m; best = i; } });
      num.textContent = String(best + 1);
    }, { passive: true });
    new IntersectionObserver(([e]) => { if (e.isIntersecting) sec.classList.add('is-in'); }, { threshold: 0.3 }).observe(sec);
  }
</script>
