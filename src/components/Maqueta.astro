---
import type { Model } from '../lib/iso';

interface Props {
  model: Model;
}
const { model } = Astro.props;
---

<svg class="mq" viewBox={`0 0 ${model.w} ${model.h}`} aria-hidden="true" focusable="false">
  {
    model.pieces.map((p) => (
      <g class={`pc pc-${p.kind}`} style={`--d:${p.at.toFixed(2)}s;--lv:${p.lv}`}>
        {p.faces.map((f) => (
          <path class={f.cls} d={f.d} />
        ))}
        <path class="pc-e" d={p.edges} />
      </g>
    ))
  }
</svg>

<style>
  .mq { display: block; width: 100%; height: 100%; overflow: visible; }
  .pc-e { fill: none; stroke: #2b2f36; stroke-width: 1; stroke-linejoin: round; stroke-linecap: round; }
  /* Maqueta blanca: tres tonos de papel según la cara */
  .t-paper.f-top { fill: #fffdf9; }
  .t-paper.f-left { fill: #f1ede6; }
  .t-paper.f-right { fill: #e2dcd2; }
  .t-soft.f-top { fill: #f4f1ec; }
  .t-soft.f-left { fill: #e6e1d9; }
  .t-soft.f-right { fill: #d8d2c8; }
  .t-wood.f-top { fill: #d9bf9c; }
  .t-wood.f-left { fill: #c6a782; }
  .t-wood.f-right { fill: #b5946e; }
  .t-water.f-top { fill: #7fc4e8; }
  .t-water.f-left, .t-water.f-right { fill: #5fb0dc; }
  .t-glass.f-top, .t-glass.f-left, .t-glass.f-right { fill: #cfe6f3; }
  /* Remodelación: lo existente en gris tenue, lo nuevo en el azul de la marca */
  .t-old.f-top { fill: #eceae6; }
  .t-old.f-left { fill: #dedbd5; }
  .t-old.f-right { fill: #d0ccc5; }
  .pc:has(.t-old) .pc-e { stroke: #8a8f97; stroke-dasharray: 4 3; }
  .t-new.f-top { fill: #e3f1f9; }
  .t-new.f-left { fill: #c4e1f2; }
  .t-new.f-right { fill: #a9d3ec; }
  .pc:has(.t-new) .pc-e { stroke: var(--color-brand-ink); }
  .tree-crown { fill: rgb(255 253 249 / 0.92); }
  .tree-shadow { fill: rgb(30 40 50 / 0.08); }
  .person-head { fill: #2b2f36; }
  .pc-person .pc-e { stroke-width: 1.4; }

  /* Armado: cada pieza baja a su sitio cuando la maqueta entra en pantalla */
  .pc { transition: transform 0.7s var(--ease-out-expo); }
  :global(html.js) .mq .pc { opacity: 0; transform: translateY(-26px); }
  :global(html.js .is-built) .mq .pc {
    opacity: 1;
    transform: none;
    animation: mq-in 0.9s var(--ease-out-expo) backwards;
    animation-delay: calc(var(--d) * 1.6s);
  }
  @keyframes mq-in {
    from { opacity: 0; transform: translateY(-26px); }
  }
  /* Vista explotada al pasar el mouse: cada nivel sube un poco más */
  :global(html.js .is-built.is-exploded) .mq .pc { transform: translateY(calc(var(--lv) * -14px)); transition-delay: calc(var(--lv) * 40ms); }
  :global(html.rm) .mq .pc { opacity: 1 !important; transform: none !important; animation: none !important; }
</style>
