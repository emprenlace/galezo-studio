---
/**
 * Cifra de respaldo con gesto de plano: el número cuenta desde cero al aparecer y luego un trazo azul a mano lo
 * encierra, como el arquitecto que marca una cota en la lámina. Toma la tipografía de quien la contiene
 * (en los héroes: serif itálica azul). Sin JS o con movimiento reducido se ve el número final y el círculo quieto.
 */
interface Props {
  v: number;
  pre?: string;
}
const { v, pre = '+' } = Astro.props;
---

<b class="cf" data-cifra={v}>
  <span class="cf-tx">{pre}<span class="cf-n" data-cifra-n>{v}</span></span>
  <svg class="cf-ring" viewBox="0 0 100 50" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M80 9C63 1 22 3 9 17C-2 30 22 46 55 44C86 42 101 27 89 14C82 7 68 4 57 6"></path>
  </svg>
</b>

<style>
  .cf { position: relative; display: inline-block; margin: 0 10px 0 8px; }
  .cf-tx { position: relative; }
  /* ancho fijo para que el texto de al lado no se mueva mientras cuenta */
  .cf-n { display: inline-block; min-width: 1.15em; text-align: left; font-variant-numeric: tabular-nums; }
  .cf-ring { position: absolute; left: -32%; top: -26%; width: 158%; height: 156%; overflow: visible; pointer-events: none; }
  .cf-ring path { fill: none; stroke: var(--color-brand); stroke-width: 1.5; stroke-linecap: round; vector-effect: non-scaling-stroke; opacity: 0.85; stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(html.js:not(.rm)) .cf-ring path { stroke-dashoffset: 1; }
  :global(html.js:not(.rm)) .cf.is-ring .cf-ring path { stroke-dashoffset: 0; transition: stroke-dashoffset 0.9s cubic-bezier(0.5, 0, 0.2, 1); }
</style>

<script>
  const els = [...document.querySelectorAll<HTMLElement>('[data-cifra]')];
  if (els.length && !document.documentElement.classList.contains('rm')) {
    const run = (el: HTMLElement) => {
      const n = el.querySelector<HTMLElement>('[data-cifra-n]')!;
      const to = Number(el.dataset.cifra);
      const dur = 1400;
      let t0 = 0;
      n.textContent = '0';
      const tick = (t: number) => {
        if (!t0) t0 = t;
        const k = Math.min(1, (t - t0) / dur);
        n.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(tick);
        else el.classList.add('is-ring');
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        // espera a que la línea de respaldo termine de entrar
        setTimeout(() => run(e.target as HTMLElement), 650);
      });
    }, { threshold: 0.6 });
    els.forEach((el) => { el.querySelector<HTMLElement>('[data-cifra-n]')!.textContent = '0'; io.observe(el); });
  }
</script>
