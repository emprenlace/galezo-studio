---
/**
 * Imagen que se pide cuando su sección se acerca a la pantalla (no al abrir la página).
 * La carga diferida del navegador no basta: en redes lentas Chrome adelanta todo lo que esté a ~2.500 px,
 * y en páginas de secciones a pantalla completa eso arrastra dos o tres secciones de imágenes de entrada.
 * Mientras tanto muestra un píxel transparente; sin JS, <noscript> deja la imagen normal.
 */
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  style?: string;
  quality?: number;
  /** se pide un momento después que las demás de su sección (las que no se ven de entrada, p. ej. otras diapositivas) */
  later?: boolean;
}
const { src, alt, widths, sizes, class: cls, style, quality = 76, later = false } = Astro.props;
const img = await getImage({ src, widths, format: 'webp', quality });
// mientras está el píxel, la proporción la da el estilo (el píxel es cuadrado y haría saltar el diseño al cargar)
const st = [`aspect-ratio:${src.width}/${src.height}`, style].filter(Boolean).join(';');
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---

<img src={PIXEL} data-lz={later ? 'later' : ''} data-src={img.src} data-srcset={img.srcSet.attribute} sizes={sizes} alt={alt} width={src.width} height={src.height} decoding="async" class={cls} style={st} /><noscript><img src={img.src} srcset={img.srcSet.attribute} sizes={sizes} alt={alt} width={src.width} height={src.height} class={cls} style={style} /></noscript>

<script>
  // la lógica vive en lib/lazy.ts (la usan también otras secciones con <img data-lz>)
  import '../lib/lazy';
</script>
