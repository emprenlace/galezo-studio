---
/**
 * Botón flotante de WhatsApp directo (pedido de Ulises): abre WhatsApp con un saludo según la página (lib/contacto.ts → saludos).
 * - Aparece después del héroe (los héroes ya tienen su botón) y se esconde con el chat abierto y en el cierre, que tiene el suyo.
 * - No aparece en /contacto: ahí el WhatsApp ya está a la vista.
 * - Medición: data-contact="whatsapp" + data-cta="flotante" → contact_whatsapp (lo registra Base.astro). Es contacto directo,
 *   sin calificar: no se reporta a la pauta como lead.
 */
import { contacto, waLink, saludos } from '../lib/contacto';

// clave del saludo: el servicio de la página, o el tipo de página (about), o el general
const { clave = 'general' } = Astro.props as { clave?: string };
const texto = saludos[clave] || saludos.general;
---

<a class="wf" href={waLink(texto)} target="_blank" rel="noopener" data-contact="whatsapp" data-cta="flotante" data-wf aria-label={`Escríbenos por WhatsApp al ${contacto.whatsappLabel}`}>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 28.6l6.4-1.7A12.7 12.7 0 1 0 16 3.2Zm0 23.2a10.5 10.5 0 0 1-5.4-1.5l-.4-.2-3.8 1 1-3.7-.2-.4A10.5 10.5 0 1 1 16 26.4Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.6.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4a3.3 3.3 0 0 0-1 2.5 5.8 5.8 0 0 0 1.2 3.1 13.3 13.3 0 0 0 5.1 4.5c1.9.8 2.6.9 3.6.7.6-.1 1.9-.8 2.1-1.5.3-.7.3-1.3.2-1.5-.1-.1-.3-.2-.6-.4Z" />
  </svg>
  <span class="wf-t">Escríbenos</span>
</a>

<style>
  /* un círculo con el ícono; en computador el texto se despliega al pasar el mouse (así no tapa contenido) */
  .wf {
    position: fixed;
    right: calc(14px + env(safe-area-inset-right));
    bottom: calc(14px + env(safe-area-inset-bottom));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    height: 52px;
    padding: 0 13px;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 24px -10px rgb(10 60 30 / 0.55), 0 2px 6px rgb(0 0 0 / 0.08);
    opacity: 0;
    transform: translateY(16px) scale(0.92);
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.5s var(--ease-out-expo), background-color 0.3s;
  }
  .wf.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .wf:hover { background: #1ebe5b; }
  .wf svg { width: 26px; height: 26px; fill: currentColor; flex: none; }
  .wf-t { max-width: 0; overflow: hidden; white-space: nowrap; font-size: 14.5px; font-weight: 600; letter-spacing: -0.01em; transition: max-width 0.45s var(--ease-out-expo), margin 0.45s var(--ease-out-expo); }
  .wf:hover .wf-t, .wf:focus-visible .wf-t { max-width: 110px; margin-left: 8px; }
  @media (min-width: 1024px) {
    .wf { right: 20px; bottom: 20px; }
  }
  :global(html.cz-open) .wf { opacity: 0 !important; pointer-events: none !important; }
  :global(html.rm) .wf { transition: none; }
</style>

<script>
  const wf = document.querySelector<HTMLElement>('[data-wf]');
  if (wf) {
    // visible después del primer pantallazo y fuera del cierre (que tiene su propio botón)
    let pastHero = false;
    let inCierre = false;
    const set = () => wf.classList.toggle('is-on', pastHero && !inCierre);
    const onScroll = () => {
      const v = scrollY > innerHeight * 0.75;
      if (v !== pastHero) { pastHero = v; set(); }
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    const ci = document.querySelector('[data-ci]');
    if (ci) new IntersectionObserver(([e]) => { inCierre = e.isIntersecting; set(); }, { threshold: 0.15 }).observe(ci);
  }
</script>
