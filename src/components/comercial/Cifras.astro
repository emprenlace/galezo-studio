---
/**
 * Comercial e institucional · 04 "Respaldo en cifras": cuatro datos reales que cuentan solos al aparecer,
 * y quién está detrás (Ulises). Sin su cargo en la Gobernación: no debe leerse como ventaja para ganar contratos. Sin logos: ya están en "Para quién".
 */
import { Image } from 'astro:assets';
import Plomada from '../Plomada.astro';
import Trazos from '../Trazos.astro';
import ulises from '../../assets/ulises-rostro.jpg';

const { n = '04' } = Astro.props as { n?: string };
const cifras = [
  { pre: '+', v: 60, t: 'proyectos diseñados' },
  { pre: '', v: 6, t: 'obras públicas en el Cesar' },
  { pre: '+', v: 6, t: 'años de experiencia en el sector público y privado' },
  { pre: '', v: 10, t: 'entidades y empresas clientes' },
];
---

<section class="cf2" data-nav-label="Respaldo" aria-labelledby="cf2-title" data-cf2>
  <Trazos left="rosa" right="muro" />
  <div class="cf2-in">
    <Plomada n={n} label="Respaldo" variant="firma" />
    <h2 id="cf2-title" class="cf2-h2 cf2-rv">Un estudio con <span class="accent">obra construida</span></h2>

    <ul class="nums" role="list">
      {
        cifras.map((c, i) => (
          <li class="num" style={`--i:${i}`}>
            {c.lab && <span class="n-lab">{c.lab}</span>}
            <span class="n-v">{c.pre}<span data-count={c.v} data-from={c.v > 1000 ? c.v - 12 : 0}>{c.v}</span></span>
            <span class="n-t">{c.t}</span>
          </li>
        ))
      }
    </ul>

    <div class="who cf2-rv">
      <Image src={ulises} alt="Ulises Galezo Cifuentes" width={120} height={120} class="who-ph chamfer" loading="lazy" />
      <p>
        <strong>Ulises Galezo Cifuentes</strong>
        <span>Arquitecto, fundador de Galezo Studio. Lidera el diseño de cada proyecto junto a su equipo.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .cf2 { --pad: 20px; --hd: 76px; position: relative; isolation: isolate; background: var(--color-bone); min-height: 100svh; display: flex; padding: calc(var(--hd) + 6px) var(--pad) 22px; overflow: hidden; }
  .cf2-in { position: relative; z-index: 1; width: 100%; max-width: 1100px; margin: auto; display: flex; flex-direction: column; align-items: center; gap: clamp(14px, 2.6svh, 30px); }
  .cf2-h2 { font-size: clamp(1.7rem, min(1.2rem + 2.6vw, 5.2svh), 3.3rem); line-height: 1.03; font-weight: 560; letter-spacing: -0.038em; text-align: center; text-wrap: balance; }
  .cf2-h2 .accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; color: var(--color-brand); font-size: 1.08em; }

  .nums { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .num { --cut: 12px; display: grid; align-content: center; justify-items: center; gap: 2px; padding: 16px 10px 14px; text-align: center; background: #fff; clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); }
  .n-lab { font-size: 11.5px; font-weight: 600; color: var(--color-ink-mute); }
  .n-v { font-family: var(--font-serif); font-style: italic; font-size: clamp(2.6rem, 2rem + 3vw, 4.6rem); line-height: 1; letter-spacing: -0.02em; color: var(--color-brand); font-variant-numeric: tabular-nums; }
  .n-t { font-size: 12.5px; font-weight: 600; line-height: 1.3; color: var(--color-ink); text-wrap: balance; }

  .who { display: grid; grid-template-columns: 64px 1fr; gap: 14px; align-items: center; max-width: 560px; }
  .who :global(.who-ph) { --cut: 8px; width: 64px; height: 64px; object-fit: cover; object-position: 50% 18%; filter: grayscale(1); }
  .who p { display: grid; gap: 3px; font-size: 0.88rem; line-height: 1.42; }
  .who strong { font-size: 1rem; font-weight: 620; letter-spacing: -0.015em; }
  .who span { color: var(--color-ink-soft); }

  :global(html.js) .cf2-rv, :global(html.js) .num { opacity: 0; transform: translateY(14px); }
  :global(html.js) .cf2.is-in .cf2-rv { opacity: 1; transform: none; transition: opacity 0.8s, transform 1s var(--ease-out-expo); }
  :global(html.js) .cf2.is-in .who { transition-delay: 0.6s; }
  :global(html.js) .cf2.is-in .num { opacity: 1; transform: none; transition: opacity 0.6s, transform 0.8s var(--ease-out-expo); transition-delay: calc(0.15s + var(--i) * 0.1s); }
  :global(html.rm) .cf2 * { transition: none !important; }
  :global(html.rm) :is(.cf2-rv, .num) { opacity: 1 !important; transform: none !important; }

  @media (max-width: 639px) and (max-height: 700px) {
    .num { padding: 12px 8px 10px; }
    .cf2 :global(.trz) { display: none; }
  }
  @media (max-width: 639px) and (max-height: 600px) {
    .n-v { font-size: 2.2rem; }
    .num { padding: 10px 8px 8px; }
    .who span { display: none; }
  }
  @media (min-width: 900px) {
    .cf2 { --pad: max(40px, calc((100% - 1100px) / 2)); --hd: 84px; }
    .nums { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .num { --cut: 18px; padding: 30px 16px 26px; gap: 6px; }
    .n-t { font-size: 14px; }
    .who { grid-template-columns: 84px 1fr; gap: 18px; }
    .who :global(.who-ph) { width: 84px; height: 84px; }
    .who p { font-size: 0.98rem; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-cf2]');
  if (sec) {
    new IntersectionObserver(
      (es, io) => {
        if (!es[0].isIntersecting) return;
        sec.classList.add('is-in');
        io.disconnect();
        if (document.documentElement.classList.contains('rm')) return;
        // cada cifra cuenta hasta su valor (el año arranca cerca, no desde cero)
        sec.querySelectorAll<HTMLElement>('[data-count]').forEach((el, i) => {
          const to = Number(el.dataset.count);
          const from = Number(el.dataset.from);
          const t0 = performance.now() + 150 + i * 100;
          const tick = (t: number) => {
            const k = Math.min(1, Math.max(0, (t - t0) / 1500));
            el.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - k, 3))));
            if (k < 1) requestAnimationFrame(tick);
          };
          el.textContent = String(from);
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.3 },
    ).observe(sec);
  }
</script>
