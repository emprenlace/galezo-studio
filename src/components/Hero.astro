---
/**
 * Héroe "La lámina".
 * La lámina es un dibujo a línea de una casa diseñada por Ulises: computador 2880 × 1800 (casa centrada, del 24 al 76 %
 * del ancho) y celular 1200 × 1500 (casa de lado a lado). Ambas en tinta sobre transparencia, para fundirse con el papel.
 * 1. El calco de su arquitectura (lib/calco.ts) se dibuja solo con el lápiz de la marca: suelo → pórticos → volumen → muros → vanos → lamas.
 * 2. Entra su dibujo completo (árboles, piedra, matas) y el calco se retira.
 * 3. La aguada (color sacado de su versión a color, sin líneas ni cielo) se pinta de izquierda a derecha con el lápiz en el borde;
 *    el cajetín pasa de "Boceto" a "Fachada".
 * 4. En computador, notas a mano sobre el dibujo; al pasar el mouse por una se resalta esa parte de la casa.
 * El script ubica la lámina para que cubra el panel y el techo quede siempre bajo los botones.
 * Al salir con el scroll, el texto se desvanece y el dibujo hace parallax.
 */
import { Image } from 'astro:assets';
import ulises from '../assets/ulises-rostro.jpg';
import laminaAncha from '../assets/hero/lamina-ancha.png';
import laminaAlta from '../assets/hero/lamina-alta.png';
import aguadaAncha from '../assets/hero/aguada-ancha.png';
import aguadaAlta from '../assets/hero/aguada-alta.png';
import { ancha, alta, type Grupo } from '../lib/calco';
import obra1 from '../assets/obras/mirador-ecce-homo.jpg';
import obra2 from '../assets/obras/ie-instpecam.jpg';
import obra3 from '../assets/obras/ie-alfonso-lopez.jpg';

// Obra construida (portafolio): prueba real bajo el botón
const obras = [
  { src: obra1, alt: 'Mirador al monumento del Santo Ecce Homo, Valledupar', pos: '62% 30%' },
  { src: obra2, alt: 'Institución educativa Instpecam, Valledupar', pos: '55% 55%' },
  { src: obra3, alt: 'Institución educativa Alfonso López Pumarejo, Valledupar', pos: '58% 60%' },
];

// Notas del dibujo (computador): etiqueta (lx, ly) y punto sobre el elemento (x2, y2), en px de la lámina de 2880 × 1800
const notas = [
  { t: 'muro en piedra', lx: 1150, ly: 1160, x2: 1240, y2: 1390 },
  { t: 'celosía en madera', lx: 1880, ly: 1100, x2: 1880, y2: 1265 },
];
const pct = (v: number, t: number) => +((v / t) * 100).toFixed(2);

// Tiempos del calco: cada grupo arranca a su hora; dentro del grupo las líneas se encadenan. Todo cabe en 3 s.
const inicio: Record<string, number> = { suelo: 0.2, 'portico-izq': 0.6, 'portico-centro': 0.95, 'portico-der': 1.25, volumen: 1.55, muros: 1.85, vanos: 2.05, lamas: 2.35, celosia: 2.45 };
function tiempos(grupos: Grupo[], ancho: number) {
  const trazos: { d: string; a: number; t: number; fino: boolean }[] = [];
  const ruta: { a: number; d: number; s: number[] }[] = [];
  for (const g of grupos) {
    let a = inicio[g.g] ?? 2;
    for (const [x1, y1, x2, y2] of g.l) {
      const t = g.fino ? 0.2 : Math.min(0.5, Math.max(0.14, Math.hypot(x2 - x1, y2 - y1) / (ancho * 0.55)));
      trazos.push({ d: `M${x1} ${y1}L${x2} ${y2}`, a, t, fino: !!g.fino });
      if (!g.fino) ruta.push({ a, d: t, s: [x1, y1, x2, y2] });
      a += g.fino ? 0.014 : t * 0.5;
    }
  }
  const f = Math.min(1, 3 / Math.max(...trazos.map((x) => x.a + x.t)));
  for (const x of trazos) { x.a = +(x.a * f).toFixed(3); x.t = +Math.max(0.12, x.t * f).toFixed(3); }
  for (const r of ruta) { r.a = +(r.a * f).toFixed(3); r.d = +Math.max(0.12, r.d * f).toFixed(3); }
  return { trazos, ruta };
}
// cada lámina: techo (palmas incluidas) y lo más bajo que no se debe cortar, en px de la lámina
// Solo se descarga la lámina que se ve: en la pantalla de la otra, su <picture> apunta a un píxel transparente.
// Las condiciones son las mismas del CSS que muestra una u otra (lámina ancha en horizontal desde 640 px).
const SI_ANCHA = '(orientation: landscape) and (min-width: 640px)';
const NO_ANCHA = 'not all and (orientation: landscape) and (min-width: 640px)';
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const laminas = [
  { id: 'ancha', src: laminaAncha, aguada: aguadaAncha, ...ancha, ...tiempos(ancha.grupos, 1680), techo: 1150, base: 1580, widths: [1440, 2160, 2880] },
  { id: 'alta', src: laminaAlta, aguada: aguadaAlta, ...alta, ...tiempos(alta.grupos, 1200), techo: 850, base: 1352, widths: [600, 900, 1200] },
];
const lapiz = '<g transform="rotate(-38)"><ellipse cx="190" cy="34" rx="150" ry="8" fill="#1e2228" opacity="0.07"/><path d="M60 -10 H330 Q342 -10 342 0 Q342 10 330 10 H60 Z" fill="#36727c"/><path d="M60 -3.5 H342 M60 3.5 H342" stroke="#2c5f68" stroke-width="1.4"/><path d="M60 -10 L4 0 L60 10 Z" fill="#e8d2ad"/><path d="M18 -2.6 L0 0 L18 2.6 Z" fill="#2b2f36"/><path d="M318 -10 H332 V10 H318 Z" fill="#c8ccd2"/></g>';

---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-pin" data-pin>
    <div class="panel">
      <div class="paper" aria-hidden="true"></div>

      <!-- La lámina: computador (ancha) y celular o tableta vertical (alta) -->
      {
        laminas.map((L) => (
          <div class:list={['casa', `casa-${L.id}`]} data-art={L.id} data-w={L.w} data-h={L.h} data-techo={L.techo} data-base={L.base}>
            <div class="ca-box" data-box>
              <!-- la aguada (color) va debajo del trazo y se pinta de izquierda a derecha -->
              <div class="ca-ag" data-wipe>
                <div class="ca-ag-in">
                  <picture><source media={L.id === 'ancha' ? NO_ANCHA : SI_ANCHA} srcset={PIXEL} /><Image src={L.aguada} alt="" widths={L.widths} sizes="100vw" loading="eager" class="ca-agimg" /></picture>
                </div>
              </div>
              <div class="ca-edge" aria-hidden="true"><svg class="ca-pencil" viewBox="0 0 1 1" overflow="visible" focusable="false" set:html={lapiz} /></div>
              <picture><source media={L.id === 'ancha' ? NO_ANCHA : SI_ANCHA} srcset={PIXEL} /><Image src={L.src} alt={L.id === 'ancha' ? 'Fachada de una casa diseñada por Ulises Galezo, dibujada a línea' : ''} widths={L.widths} sizes="100vw" loading="eager" fetchpriority="high" class="ca-dib" /></picture>
              <span class="ca-spot" data-spot aria-hidden="true"></span>
              <svg class="ca-calco" viewBox={`0 0 ${L.w} ${L.h}`} aria-hidden="true" focusable="false">
                {L.trazos.map((x) => <path class:list={{ fino: x.fino }} d={x.d} pathLength="1" style={`--a:${x.a}s;--t:${x.t}s`} />)}
              </svg>
              <div class="ca-pen" data-pen data-route={JSON.stringify(L.ruta)} aria-hidden="true">
                <svg viewBox="0 0 1 1" overflow="visible" focusable="false" set:html={lapiz} />
              </div>
              {L.id === 'ancha' && (
                <>
                  <svg class="ca-leaders" viewBox={`0 0 ${L.w} ${L.h}`} preserveAspectRatio="none" aria-hidden="true">
                    {notas.map((n, i) => (
                      <g class="ld" data-ld={i} style={`--i:${i}`}>
                        <path d={`M${n.lx} ${n.ly + 22} C${n.lx} ${n.ly + (n.y2 - n.ly) * 0.6}, ${n.x2} ${n.ly + 36}, ${n.x2} ${n.y2}`} />
                        <circle cx={n.x2} cy={n.y2} r="6" />
                      </g>
                    ))}
                  </svg>
                  <ul class="ca-notes" role="list">
                    {notas.map((n, i) => (
                      <li class="nt" style={`--i:${i};left:${pct(n.lx, L.w)}%;top:${pct(n.ly, L.h)}%`}>
                        <button type="button" class="nt-b" data-note={i} data-x={pct(n.x2, L.w)} data-y={pct(n.y2, L.h)}>{n.t}</button>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </div>
        ))
      }

      <!-- Instrumentos sobre la lámina (escritorio) -->
      <div class="tools" data-tools aria-hidden="true">
        <svg class="tool escuadra" viewBox="0 0 220 220">
          <path
            d="M10 10 L210 210 L10 210 Z M42 92 L42 178 L128 178 Z"
            fill-rule="evenodd"
            fill="rgb(54 114 124 / 0.1)"
            stroke="rgb(54 114 124 / 0.55)"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
          <g stroke="rgb(54 114 124 / 0.6)" stroke-width="1">
            {Array.from({ length: 19 }, (_, i) => <path d={`M${20 + i * 10} 210 V${i % 5 === 0 ? 198 : 203}`} />)}
          </g>
        </svg>
      </div>

      <!-- Escena 1: título y botones centrados en el cielo de la lámina -->
      <div class="hero-s1" data-s1>
        <h1 id="hero-title" class="hero-h1">
          <span class="hl"><span class="hl-in hk-1">Ve tu proyecto terminado</span></span>{" "}
          <span class="hl"
            ><span class="hl-in hk-2"
              ><span class="accent"
                >antes de construirlo<svg class="underline" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true"
                  ><path pathLength="1" d="M4 15 C 70 9, 150 8, 230 10 S 360 14, 396 9"></path><path
                    pathLength="1"
                    class="u2"
                    d="M40 19 C 120 15, 230 15, 330 17"></path></svg
                ></span
              ></span
            ></span
          >
        </h1>
        <p class="hero-sub hk-3">
          Planos completos, modelo BIM, renders y cantidades de obra para que tu proyecto se construya tal como lo diseñamos.
        </p>
        <div class="hero-ctas hk-4">
          <a href="#cotizar" class="btn btn-primary chamfer" data-open-chat data-cta="hero">
            Cotiza tu diseño
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
          </a>
        </div>
        <a href="#proyectos" class="hero-proof hk-5">
          <span class="proof-pics">
            {
              obras.map((o, i) => (
                <span class="proof-pic chamfer" style={`--i:${i}`}>
                  <Image src={o.src} alt={o.alt} widths={[110, 180]} sizes="54px" loading="eager" style={`object-position:${o.pos}`} />
                </span>
              ))
            }
          </span>
          <span class="proof-t">
            <strong>Diseños ya construidos</strong>
            <span>para la Gobernación del Cesar</span>
          </span>
        </a>
      </div>

      <!-- Pie: arquitecto y cajetín de la lámina -->
      <div class="hero-who hk-6" data-who>
        <Image src={ulises} alt="Ulises Galezo Cifuentes" width={88} height={88} class="hf-photo chamfer" loading="eager" />
        <p>
          <strong>Ulises Galezo Cifuentes</strong>
          <span>Arquitecto · +6 años de experiencia</span>
        </p>
      </div>
      <dl class="cajetin hk-6" aria-hidden="true">
        <div class="caj-brand"><dt>Galezo Studio</dt><dd>Diseño arquitectónico</dd></div>
        <div><dt>Proyecto</dt><dd>El tuyo</dd></div>
        <div><dt>Contenido</dt><dd data-caj-c>Boceto</dd></div>
        <div><dt>Lámina</dt><dd data-caj-n>01</dd></div>
      </dl>

      <span class="cut cut-tl" aria-hidden="true"></span>
      <span class="cut cut-br" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    --run: 0svh;
    --g: 8px;
    --hd: 60px;
    --pad: 20px;
    position: relative;
    height: calc(100svh + var(--run));
  }
  .hero-pin { position: sticky; top: 0; height: 100svh; }
  .panel {
    position: absolute;
    inset: var(--g);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bone);
  }
  /* Papel: hueso con el azul de la marca muy tenue arriba a la izquierda */
  .paper {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 55% at 0% 0%, rgb(54 114 124 / 0.11), rgb(54 114 124 / 0.04) 50%, rgb(54 114 124 / 0) 78%),
      radial-gradient(45% 38% at 50% 32%, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0) 100%);
  }
  /* Cortes a 45° del panel (como el monograma) */
  .cut { position: absolute; width: 26px; height: 26px; background: #fff; z-index: 6; pointer-events: none; }
  .cut-tl { top: -1px; left: -1px; clip-path: polygon(0 0, 100% 0, 0 100%); }
  .cut-br { bottom: -1px; right: -1px; clip-path: polygon(100% 0, 100% 100%, 0 100%); }

  /* ---------- La lámina ---------- */
  /* Ocupa todo el panel; la caja interna (data-box) tiene la proporción de su dibujo y la ubica el script.
     Sin JS: la caja cubre el panel apoyada abajo. */
  .casa { position: absolute; inset: 0; z-index: 0; overflow: hidden; transform-origin: 50% 90%; will-change: transform, opacity; }
  .casa-ancha { display: none; }
  .ca-box { position: absolute; left: 50%; bottom: 56px; width: 100%; translate: -50% 0; }
  .casa-alta .ca-box { aspect-ratio: 1200 / 1500; }
  .casa-ancha .ca-box { aspect-ratio: 2880 / 1800; }
  .ca-dib { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* Aguada: la caja avanza a la derecha y su contenido retrocede lo mismo (dos translate, compuesto).
     Es 80 px más ancha que el dibujo: ese sobrante lleva el borde suave del color. */
  .ca-ag { position: absolute; top: 0; bottom: 0; left: 0; width: calc(100% + 80px); overflow: hidden; -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 80px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 80px), transparent); will-change: transform; }
  .ca-ag-in { position: absolute; inset: 0; will-change: transform; }
  .ca-ag-in :global(img) { position: absolute; left: 0; top: 0; width: calc(100% - 80px); height: 100%; display: block; }
  .ca-edge { position: absolute; top: 0; bottom: 0; left: 0; width: 100%; pointer-events: none; opacity: 0; will-change: transform, opacity; }
  .ca-pencil { position: absolute; right: 0; top: 72%; width: 1px; height: 1px; overflow: visible; scale: var(--pk, 0.3); }
  /* trazos del calco en unidades de la lámina: el grosor sigue la escala (--sw) */
  .ca-calco { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .ca-calco path { fill: none; stroke: #262a30; stroke-width: var(--sw, 3); stroke-linecap: round; }
  .ca-calco .fino { stroke-width: calc(var(--sw, 3) * 0.5); opacity: 0.6; }
  .ca-pen { position: absolute; left: 0; top: 0; width: 1px; height: 1px; transform-origin: 0 0; will-change: transform, opacity; opacity: 0; pointer-events: none; z-index: 2; }
  .ca-pen svg { display: block; overflow: visible; }
  /* resaltado: todo se atenúa menos el elemento de la nota */
  .ca-spot {
    position: absolute;
    inset: 0;
    background: rgb(244 242 238 / 0.8);
    opacity: 0;
    transition: opacity 0.45s var(--ease-out-expo);
    -webkit-mask-image: radial-gradient(circle at var(--sx, 50%) var(--sy, 50%), transparent 0 5%, #000 11%);
    mask-image: radial-gradient(circle at var(--sx, 50%) var(--sy, 50%), transparent 0 5%, #000 11%);
    pointer-events: none;
  }
  .casa.is-spot .ca-spot { opacity: 1; }
  .ca-leaders, .ca-notes { display: none; }
  .ca-leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .ld path { fill: none; stroke: var(--color-brand); stroke-width: 1.3; vector-effect: non-scaling-stroke; stroke-linecap: round; opacity: 0.8; transition: opacity 0.3s, stroke-width 0.3s; }
  .ld circle { fill: var(--color-brand); }
  .ld.is-on path { opacity: 1; stroke-width: 2; }
  .ca-notes { position: absolute; inset: 0; pointer-events: none; }
  .nt { position: absolute; translate: -50% -50%; }
  .nt-b {
    pointer-events: auto;
    padding: 2px 6px;
    font-family: 'Architects Daughter', var(--font-sans);
    font-size: 16px;
    line-height: 1.1;
    white-space: nowrap;
    color: var(--color-brand);
    cursor: pointer;
    rotate: -2deg;
    transition: color 0.3s, translate 0.4s var(--ease-out-expo);
  }
  .nt-b:hover, .nt-b:focus-visible, .nt-b.is-on { color: var(--color-ink); }
  .nt-b.is-on { translate: 0 -3px; }

  /* ---------- Entrada (solo con JS; sin JS se ve el dibujo completo) ----------
     0,2–3,2 s el calco se dibuja con el lápiz · 2,8 s entra su dibujo y el calco se retira · 4–6,2 s el color · 6,1 s notas */
  :global(html.js) .casa .ca-calco path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(html.js) .casa.go .ca-calco path { animation: ca-draw var(--t) var(--a) cubic-bezier(0.45, 0.05, 0.3, 1) forwards; }
  :global(html.js) .casa.go .ca-calco { animation: ca-out 1.4s 3.4s ease forwards; }
  :global(html.js) .casa .ca-dib { opacity: 0; }
  :global(html.js) .casa.go .ca-dib { animation: ca-in 1.6s 2.8s ease both; }
  :global(html.js) .casa .ca-ag { transform: translateX(-100%); }
  :global(html.js) .casa .ca-ag-in { transform: translateX(100%); }
  :global(html.js) .casa .ca-edge { transform: translateX(-100%); }
  :global(html.js) .casa.go :is(.ca-ag, .ca-ag-in) { animation: ca-wipe 2.2s 4s cubic-bezier(0.55, 0.05, 0.3, 1) forwards; }
  :global(html.js) .casa.go .ca-edge { animation: ca-wipe 2.2s 4s cubic-bezier(0.55, 0.05, 0.3, 1) forwards, ca-pen 2.5s 3.85s ease both; }
  @keyframes ca-wipe { to { transform: none; } }
  @keyframes ca-pen { 0% { opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { opacity: 0; } }
  :global(html.js) .casa .ld, :global(html.js) .casa .nt { opacity: 0; }
  :global(html.js) .casa.go .ld, :global(html.js) .casa.go .nt { animation: ca-in 0.8s ease both; animation-delay: calc(6.1s + var(--i) * 0.16s); }
  @keyframes ca-draw { to { stroke-dashoffset: 0; } }
  @keyframes ca-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ca-out { to { opacity: 0; } }
  :global(html:not(.js)) .casa :is(.ca-calco, .ca-pen, .ca-edge) { display: none; }
  :global(html.rm) .casa :is(.ca-calco, .ca-pen, .ca-edge) { display: none; }
  :global(html.rm) .casa :is(.ca-ag, .ca-ag-in) { animation: none !important; transform: none !important; }
  :global(html.rm) .casa :is(.ca-dib, .ld, .nt) { animation: none !important; opacity: 1 !important; }

  .casa picture { display: contents; }
  /* Lámina ancha en pantallas horizontales; la alta en celular y tableta vertical */
  @media (orientation: landscape) and (min-width: 640px) {
    .casa-alta { display: none; }
    .casa-ancha { display: block; }
    .ca-box { bottom: 0; }
  }

  /* Celular y tableta: el título queda centrado en el cielo, entre la cabecera y el techo de la casa */
  @media (max-width: 1023px) {
    .hero-s1 {
      top: calc(var(--hd) + env(safe-area-inset-top));
      bottom: var(--s1b, 45%);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  .tools { position: absolute; inset: 0; pointer-events: none; z-index: 1; display: none; }
  .tool { position: absolute; overflow: visible; filter: drop-shadow(0 8px 10px rgb(30 34 40 / 0.12)); }
  .escuadra {
    width: clamp(100px, 9.5vw, 150px);
    right: -1.2%;
    top: 52%;
    rotate: -18deg;
    translate: calc(var(--mx, 0) * -8px) calc(var(--my, 0) * -5px);
    transition: translate 0.8s var(--ease-out-expo);
  }

  /* ---------- Escena 1 ---------- */
  .hero-s1 {
    position: absolute;
    top: calc(var(--hd) + env(safe-area-inset-top) + clamp(8px, 2.6svh, 34px));
    left: 0;
    right: 0;
    padding: 0 var(--pad);
    text-align: center;
    z-index: 3;
    will-change: transform, opacity;
    pointer-events: none;
  }
  /* El bloque ocupa todo el ancho: solo sus enlaces y botones reciben el mouse (el tablero de acabados queda usable) */
  .hero-s1 a, .hero-s1 button { pointer-events: auto; }
  .hero-h1 {
    font-size: clamp(2.02rem, min(5.4vw, 6.4svh), 3.9rem);
    line-height: 1.02;
    font-weight: 560;
    letter-spacing: -0.038em;
  }
  /* Cada línea sube desde adentro de su propia ventana */
  .hl { display: block; overflow: hidden; padding: 0.04em 0.1em 0.32em; margin-bottom: -0.28em; }
  .hl-in { display: inline-block; }
  .hero-h1 .accent { position: relative; display: inline-block; color: var(--color-brand); font-size: 1.1em; line-height: 0.95; letter-spacing: -0.012em; }
  /* Celulares bajitos (iPhone SE): el título de tres líneas baja un punto para no tocar la cabecera */
  @media (max-width: 360px) and (max-height: 640px) {
    /* sin espacio para las fotos de obra sobre la casa: aparecen más abajo, en Proyectos */
    .hero-s1 .hero-proof { display: none; }
    .hero-h1 { font-size: 1.72rem; }
    .hero-sub { font-size: 0.9rem; }
    .hero-s1 { top: calc(var(--hd) + 6px); bottom: auto; justify-content: flex-start; }
  }
  .underline { position: absolute; left: -2%; width: 104%; bottom: -0.2em; height: 0.28em; overflow: visible; pointer-events: none; }
  .underline path { fill: none; stroke: var(--color-brand); stroke-width: 3.2; stroke-linecap: round; vector-effect: non-scaling-stroke; opacity: 0.85; }
  .underline .u2 { stroke-width: 1.8; opacity: 0.55; }
  .hero-sub {
    margin: clamp(8px, 1.4svh, 14px) auto 0;
    max-width: 31rem;
    font-size: clamp(0.98rem, 0.9rem + 0.3vw, 1.12rem);
    line-height: 1.5;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }
  .hero-ctas {
    position: relative;
    margin: clamp(16px, 2.6svh, 26px) auto 0;
    display: flex;
    justify-content: center;
    width: fit-content;
  }
  .hero-ctas > a { min-width: 0; }
  .btn {
    --cut: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 50px;
    padding: 0 26px;
    font-size: 15px;
    font-weight: 560;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .btn svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.45s var(--ease-out-expo);
  }
  .btn-primary { background: var(--color-brand-ink); color: #fff; transition: background-color 0.3s var(--ease-out-expo); }
  .btn-primary:hover { background: var(--color-ink); }
  .btn-primary:hover svg { transform: translateX(3px); }
  /* Prueba real: fotos de obra construida, como fotos sueltas sobre la mesa */
  .hero-proof {
    margin: 18px auto 0;
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 14px;
    text-align: left;
    border-radius: 4px;
  }
  .proof-pics { display: flex; padding-left: 6px; }
  .proof-pic {
    --cut: 7px;
    position: relative;
    width: 52px;
    height: 52px;
    margin-left: -10px;
    background: #fff;
    padding: 2px;
    rotate: calc((var(--i) - 1) * 5deg);
    translate: 0 calc(var(--i) * 1px - 1px);
    box-shadow: 0 6px 12px -6px rgb(20 34 37 / 0.45);
    transition: rotate 0.5s var(--ease-out-expo), translate 0.5s var(--ease-out-expo), margin 0.5s var(--ease-out-expo);
  }
  .proof-pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }
  .hero-proof:hover .proof-pic { margin-left: -4px; rotate: calc((var(--i) - 1) * 8deg); translate: 0 -3px; }
  .proof-t { display: grid; gap: 1px; font-size: 13px; line-height: 1.3; }
  .proof-t strong { font-weight: 600; color: var(--color-ink); letter-spacing: -0.01em; }
  .proof-t span { color: var(--color-ink-mute); }
  .hero-proof:hover .proof-t strong { color: var(--color-brand-ink); }

  /* ---------- Pie ---------- */
  .hero-who {
    position: absolute;
    left: 50%;
    bottom: calc(14px + env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    z-index: 3;
  }
  .hf-photo { --cut: 6px; width: 38px; height: 38px; object-fit: cover; object-position: 50% 18%; filter: grayscale(1); }
  .hero-who p { display: grid; gap: 2px; font-size: 13px; line-height: 1.3; }
  .hero-who strong { font-weight: 600; letter-spacing: -0.01em; }
  .hero-who span { color: var(--color-ink-mute); }

  .cajetin {
    position: absolute;
    right: var(--pad);
    bottom: 16px;
    z-index: 3;
    display: none;
    grid-template-columns: repeat(4, auto);
    border: 1px solid rgb(35 38 43 / 0.4);
    background: rgb(255 253 249 / 0.92);
    font-size: 11px;
    line-height: 1.2;
    color: #23262b;
  }
  .cajetin > div { padding: 6px 11px 7px; }
  .cajetin > div + div { border-left: 1px solid rgb(35 38 43 / 0.25); }
  .cajetin dt { font-size: 9.5px; color: #7a7f87; }
  .cajetin dd { margin-top: 2px; font-weight: 600; white-space: nowrap; }
  .caj-brand dt { color: var(--color-brand-ink); font-weight: 700; font-size: 10.5px; }
  .caj-brand dd { font-weight: 500; color: #5c616a; }
  .cajetin .roll { animation: roll 0.5s var(--ease-out-expo); }
  @keyframes roll { from { opacity: 0; transform: translateY(50%); } }

  /* ---------- Entradas suaves (red de seguridad: solo con html.js) ---------- */
  :global(html.js) .hl-in { animation: rise 1.25s var(--ease-out-expo) both; }
  :global(html.js) .hk-1 { animation-delay: 0.15s; }
  :global(html.js) .hk-2 { animation-delay: 0.27s; }
  @keyframes rise { from { transform: translateY(108%); } }
  :global(html.js) .hk-3, :global(html.js) .hk-4, :global(html.js) .hk-5, :global(html.js) .hk-6 { animation: fade-up 1.2s var(--ease-out-expo) both; }
  :global(html.js) .hk-3 { animation-delay: 0.5s; }
  :global(html.js) .hk-4 { animation-delay: 0.65s; }
  :global(html.js) .hk-5 { animation-delay: 0.8s; }
  :global(html.js) .hk-6 { animation-delay: 2.2s; }
  @keyframes fade-up { from { opacity: 0; translate: 0 14px; } }
  :global(html.js) .underline path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw-line 1.1s 1.1s cubic-bezier(0.6, 0, 0.3, 1) forwards; }
  :global(html.js) .underline .u2 { animation-delay: 1.7s; animation-duration: 0.7s; }
  @keyframes draw-line { to { stroke-dashoffset: 0; } }
  @keyframes hero-ink { to { opacity: 1; } }
  :global(html.js) .escuadra { animation: tool-in 1.6s 1.4s var(--ease-out-expo) both; }
    @keyframes tool-in { from { opacity: 0; transform: translateY(26px); } }
  :global(html.rm) .hl-in, :global(html.rm) .hk-3, :global(html.rm) .hk-4, :global(html.rm) .hk-5, :global(html.rm) .hk-6,
  :global(html.rm) .escuadra { animation: none; }
  :global(html.rm) .underline path { animation: none; stroke-dashoffset: 0; }

  /* Sin JS: todo apilado y visible */
  :global(html:not(.js)) .hero { height: auto; }
  :global(html:not(.js)) .hero-pin { position: relative; height: auto; }
  :global(html:not(.js)) .panel { position: relative; inset: auto; margin: var(--g); padding-bottom: 60px; }
  :global(html:not(.js)) .hero-s1 { position: relative; inset: auto; translate: none; left: auto; width: 100%; }
  :global(html:not(.js)) .casa { position: relative; height: 70vw; }
  :global(html:not(.js)) .hero-s1 { padding-top: calc(var(--hd) + 40px); }

  @media (min-width: 640px) {
    .hero { --pad: 28px; }
    .cajetin { display: grid; }
    .caj-brand { display: none; }
    /* sobre el dibujo: la firma va en papel, como el cajetín */
    .hero-who { left: var(--pad); translate: none; padding: 6px 12px 6px 6px; background: rgb(255 253 249 / 0.92); border: 1px solid rgb(35 38 43 / 0.18); }
  }


  @media (min-width: 1024px) {
    .hero { --g: 10px; --hd: 76px; --pad: max(40px, calc((100% - 1200px) / 2)); }
    /* El bloque de texto baja al centro del cielo de la lámina */
    .hero-s1 { top: calc(var(--hd) + clamp(20px, 6.5svh, 70px)); }
    .cut { width: 34px; height: 34px; }
    /* La casa abajo; a los lados quedan las notas y las líneas de la lámina */
    /* ancho según el alto de la pantalla: el techo siempre queda debajo de los botones (medido de 720 a 1080 px de alto) */
    .casa-ancha :is(.ca-leaders, .ca-notes) { display: block; }
    .tools { display: block; }
    .escuadra { top: 24%; }
      .caj-brand { display: block; }
  }
  @media (min-width: 1024px) and (max-height: 760px) {
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const pin = hero.querySelector<HTMLElement>('[data-pin]')!;
  const s1 = hero.querySelector<HTMLElement>('[data-s1]')!;
  const who = hero.querySelector<HTMLElement>('[data-who]')!;
  const arts = [...hero.querySelectorAll<HTMLElement>('[data-art]')];
  let art = arts[0];
  const pickArt = () => (art = arts.find((a) => getComputedStyle(a).display !== 'none') || arts[0]);
  pickArt();
  const tools = hero.querySelector<HTMLElement>('[data-tools]')!;
  const cajC = hero.querySelector<HTMLElement>('[data-caj-c]')!;

  const root = document.documentElement;
  root.classList.add('ready');
  const reduced = root.classList.contains('rm');
  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  // ---------- Ubicación de la lámina ----------
  // La caja del dibujo cubre el panel (escala "cover") y se apoya abajo. Si así el techo tocaría el texto, sube el texto
  // de margen: la lámina baja y se recorta el suelo; si ni recortando cabe, se achica lo justo.
  const panelEl = hero.querySelector<HTMLElement>('.panel')!;
  const textBottom = () => {
    const els = [...s1.querySelectorAll<HTMLElement>('.hero-ctas, .hero-proof')].filter((e) => e.offsetParent);
    return s1.offsetTop + Math.max(...els.map((e) => e.offsetTop + e.offsetHeight));
  };
  let k = 1;
  const placeArt = () => {
    pickArt();
    const box = art.querySelector<HTMLElement>('[data-box]')!;
    const W = +art.dataset.w!, H = +art.dataset.h!, techo = +art.dataset.techo!, base = +art.dataset.base!;
    const PW = panelEl.clientWidth, PH = panelEl.clientHeight;
    const alta = art.dataset.art === 'alta';
    // celular: ancho completo y sobre la firma; computador: cubre todo el panel
    const foot = alta ? 56 : 0;
    let s = alta ? PW / W : Math.max(PW / W, PH / H);
    // la base del dibujo (no el borde de la imagen) se apoya sobre la firma en celular y en el borde en computador
    let top = alta ? PH - foot - base * s : PH - H * s;
    if (alta) {
      // el texto ocupa el cielo; la lámina no puede quedar por encima de donde termina
      s1.style.setProperty('--s1b', `${(PH - (top + techo * s) + 10).toFixed(0)}px`);
    } else {
      const tb = textBottom() + 18;
      top = Math.max(top, tb - techo * s);
      if (top + base * s > PH) {
        s = (PH - tb) / (base - techo);
        top = tb - techo * s;
      }
    }
    k = s;
    art.style.setProperty('--pk', Math.min(0.36, Math.max(0.2, 0.3 * Math.sqrt(innerWidth / 1440))).toFixed(3));
    box.style.cssText = `left:${((PW - W * s) / 2).toFixed(1)}px;top:${top.toFixed(1)}px;width:${(W * s).toFixed(1)}px;height:${(H * s).toFixed(1)}px;bottom:auto;translate:none;--sw:${(1.6 / s).toFixed(2)};`;
  };
  // Notas: si en esta pantalla una cae sobre el texto o sus fotos, se oculta (con su línea)
  const fitNotes = () => {
    const blocks = [...s1.querySelectorAll<HTMLElement>('.hero-sub, .hero-ctas, .hero-proof')].filter((e) => e.offsetParent).map((e) => e.getBoundingClientRect());
    for (const li of art.querySelectorAll<HTMLElement>('.nt')) {
      li.style.visibility = '';
      const r = li.getBoundingClientRect();
      const hit = blocks.some((b) => r.left < b.right + 12 && r.right > b.left - 12 && r.top < b.bottom + 10 && r.bottom > b.top - 10);
      li.style.visibility = hit ? 'hidden' : '';
      const ld = art.querySelector<SVGGElement>(`[data-ld="${li.querySelector<HTMLElement>('[data-note]')!.dataset.note}"]`);
      if (ld) ld.style.visibility = hit ? 'hidden' : '';
    }
  };
  const placeAll = () => { placeArt(); fitNotes(); };
  placeAll();
  document.fonts?.ready.then(placeAll);
  addEventListener('resize', placeAll, { passive: true });

  // ---------- Arranque: el calco se dibuja con el lápiz; luego entra su dibujo ----------
  // Empieza después del primer pintado, cuando el dibujo ya cargó, para no competir con la carga.
  let started = false;
  const go = () => {
    if (started) return;
    started = true;
    requestAnimationFrame(() =>
      requestAnimationFrame((now) => {
        art.classList.add('go');
        const pen = art.querySelector<HTMLElement>('[data-pen]');
        if (pen && !reduced) drawPen(pen, now);
      }),
    );
  };
  const dib = art.querySelector<HTMLImageElement>('.ca-dib');
  if (!dib || dib.complete) go();
  else dib.addEventListener('load', go, { once: true });
  setTimeout(go, 1500);

  // El lápiz sigue cada línea del calco mientras se dibuja (solo transform: no repinta)
  function drawPen(pen: HTMLElement, t0: number) {
    const route: { a: number; d: number; s: number[] }[] = JSON.parse(pen.dataset.route || '[]');
    if (!route.length) return;
    const end = Math.max(...route.map((r) => r.a + r.d));
    const io = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const target = (t: number): [number, number] => {
      let act = null;
      for (const r of route) if (r.a <= t && t < r.a + r.d) act = r;
      if (act) {
        const u = io((t - act.a) / act.d);
        return [act.s[0] + (act.s[2] - act.s[0]) * u, act.s[1] + (act.s[3] - act.s[1]) * u];
      }
      const next = route.find((r) => r.a > t);
      return next ? [next.s[0], next.s[1]] : [route[route.length - 1].s[2], route[route.length - 1].s[3]];
    };
    let pos: [number, number] = [route[0].s[0] + 200, route[0].s[1] - 300];
    let last = t0;
    pen.style.opacity = '1';
    pen.style.transition = 'opacity 0.4s ease';
    const step = (now: number) => {
      const t = (now - t0) / 1000;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      const [tx, ty] = target(t);
      const e = 1 - Math.exp(-dt * 18);
      pos = [pos[0] + (tx - pos[0]) * e, pos[1] + (ty - pos[1]) * e];
      const ps = Math.min(0.36, Math.max(0.2, 0.3 * Math.sqrt(innerWidth / 1440)));
      pen.style.transform = `translate3d(${(pos[0] * k).toFixed(1)}px, ${(pos[1] * k).toFixed(1)}px, 0) scale(${ps.toFixed(3)})`;
      if (t > end + 0.05 && pen.style.opacity !== '0') pen.style.opacity = '0';
      if (t < end + 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
  // El cajetín cambia de "Boceto" a "Fachada" cuando termina de pintarse el color
  const toFachada = () => {
    cajC.textContent = 'Fachada';
    cajC.classList.remove('roll');
    void cajC.offsetWidth;
    cajC.classList.add('roll');
  };
  if (reduced) cajC.textContent = 'Fachada';
  else art.querySelector('[data-wipe]')?.addEventListener('animationend', toFachada, { once: true });

  // ---------- Notas: resaltan el elemento del dibujo ----------
  {
    const spot = art.querySelector<HTMLElement>('[data-spot]')!;
    const notes = [...art.querySelectorAll<HTMLButtonElement>('[data-note]')];
    const leaders = [...art.querySelectorAll<SVGGElement>('[data-ld]')];
    const show = (b: HTMLButtonElement | null) => {
      for (const n of notes) n.classList.toggle('is-on', n === b);
      for (const l of leaders) l.classList.toggle('is-on', !!b && l.dataset.ld === b.dataset.note);
      if (b) {
        spot.style.setProperty('--sx', `${b.dataset.x}%`);
        spot.style.setProperty('--sy', `${b.dataset.y}%`);
      }
      art.classList.toggle('is-spot', !!b);
    };
    for (const n of notes) {
      n.addEventListener('pointerenter', () => show(n));
      n.addEventListener('focus', () => show(n));
      n.addEventListener('click', () => show(n.classList.contains('is-on') ? null : n));
      n.addEventListener('pointerleave', () => show(null));
      n.addEventListener('blur', () => show(null));
    }
  }

  // ---------- Scroll: del boceto a las láminas del entregable ----------
  let H = 0;
  const measure = () => (H = pin.getBoundingClientRect().height);
  let target = 0;
  let smooth = 0;
  const readScroll = () => {
    // 0 con el héroe completo en pantalla, 1 cuando ya salió casi entero
    const r = hero.getBoundingClientRect();
    target = clamp01(-r.top / (r.height * 0.85));
  };

  let sent = '';
  function announce() {
    if (hero.getBoundingClientRect().bottom < innerHeight * 0.5) return;
    if (sent !== 'Inicio') {
      sent = 'Inicio';
      dispatchEvent(new CustomEvent('section', { detail: 'Inicio' }));
    }
  }

  function paint(sp: number) {
    // Salida: el texto sube y se desvanece; el dibujo se queda un poco atrás (parallax) y se atenúa
    const a1 = ease(clamp01(sp / 0.55));
    const s1On = a1 < 0.5;
    if (s1On !== root.classList.contains('s1-on')) root.classList.toggle('s1-on', s1On);
    announce();
    s1.style.opacity = String(1 - a1);
    s1.style.transform = `translate3d(0, ${(-a1 * 60).toFixed(1)}px, 0)`;
    who.style.opacity = String(1 - clamp01(a1 * 1.6));
    art.style.transform = `translate3d(0, ${(sp * 0.35 * H).toFixed(1)}px, 0)`;
    art.style.opacity = String(1 - sp * 0.45);
    tools.style.opacity = String(1 - clamp01(sp * 1.8));
    tools.style.transform = `translate3d(0, ${(sp * 0.2 * H).toFixed(1)}px, 0)`;
  }

  let visible = true;
  let raf = 0;
  let last = 0;
  function loop(now: number) {
    raf = 0;
    const dt = Math.min(0.1, (now - (last || now)) / 1000);
    last = now;
    readScroll();
    const k = reduced ? 1 : 1 - Math.exp(-dt * 9);
    smooth += (target - smooth) * k;
    if (Math.abs(target - smooth) < 0.0004) smooth = target;
    paint(smooth);
    if (visible && !document.hidden && smooth !== target) raf = requestAnimationFrame(loop);
    else last = 0;
  }
  const kick = () => {
    if (!raf && visible && !document.hidden) raf = requestAnimationFrame(loop);
  };
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    if (!visible) sent = '';
    kick();
  }).observe(hero);
  addEventListener('scroll', kick, { passive: true });
  document.addEventListener('visibilitychange', kick);
  new ResizeObserver(() => {
    measure();
    kick();
  }).observe(pin);

  // Instrumentos: siguen levemente al cursor
  if (matchMedia('(pointer: fine)').matches && !reduced) {
    hero.addEventListener('pointermove', (e) => {
      const r = pin.getBoundingClientRect();
      tools.style.setProperty('--mx', String(((e.clientX - r.left) / r.width) * 2 - 1));
      tools.style.setProperty('--my', String(((e.clientY - r.top) / r.height) * 2 - 1));
    });
  }


  measure();
  readScroll();
  smooth = target;
  paint(smooth);
</script>
