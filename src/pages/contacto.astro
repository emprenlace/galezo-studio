---
/**
 * Contacto: todos los datos del estudio en un solo lugar (pedido de Ulises: "se pierde la información").
 * Idea visual: la valla de obra, el letrero que se para en cada construcción con el arquitecto responsable
 * y cómo contactarlo. Al entrar, los parales suben desde el terreno, la valla se monta y cada dato aparece en orden.
 * El botón principal sigue siendo el chat (cotización); los datos van directo a WhatsApp, correo e Instagram
 * (contact_whatsapp / contact_email / contact_instagram con cta_id=contacto, lo registra Base.astro).
 * noindex hasta que se apruebe y los datos sean los definitivos (correo corporativo y WhatsApp Business).
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Cierre from '../components/Cierre.astro';
import mono from '../assets/brand/monogram-d.txt?raw';
import { contacto, waLink } from '../lib/contacto';

const datos = [
  { id: 'whatsapp', l: 'WhatsApp', v: contacto.whatsappLabel, href: waLink(), ext: true },
  { id: 'email', l: 'Correo', v: contacto.email, href: `mailto:${contacto.email}` },
  { id: 'instagram', l: 'Instagram', v: `@${contacto.instagram}`, href: `https://www.instagram.com/${contacto.instagram}`, ext: true },
  { id: 'estudio', l: 'Estudio', v: contacto.ciudad, d: 'Diseñamos internacionalmente' },
];
---

<Base title="Contacto · Galezo Studio" description="Escríbenos por WhatsApp, correo o Instagram. Galezo Studio, diseño arquitectónico en Valledupar, Cesar. Diseñamos internacionalmente." noindex pageType="contact">
  <Header />
  <main>
    <section class="ct" data-nav-label="Contacto" aria-labelledby="ct-title" data-ct>
      <div class="ct-in">
        <div class="ct-copy">
          <h1 id="ct-title" class="ct-h1">Hablemos de <span class="accent">tu proyecto</span></h1>
          <p class="ct-sub">Escríbenos por donde prefieras: te responde directamente el equipo que diseña tu proyecto.</p>
          <div class="ct-act">
            <a href="#cotizar" class="btn chamfer" data-open-chat data-cta="contacto">
              Cotiza tu diseño
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
            </a>
            <p class="ct-note">Respondes unas preguntas sobre tu proyecto y te escribimos por WhatsApp.</p>
          </div>
        </div>

        <!-- La valla de obra -->
        <div class="vl">
          <div class="vl-board chamfer">
            <div class="vl-hd">
              <span class="vl-logo" aria-hidden="true"><svg viewBox="0 0 1647 1914"><path transform="matrix(1 0 0 -1 0 1914)" d={mono.trim()}></path></svg></span>
              <p class="vl-brand"><b>Galezo Studio</b><span>Diseño arquitectónico</span></p>
              <p class="vl-resp"><span>Arquitecto responsable</span><b>Ulises Galezo Cifuentes</b></p>
            </div>
            <ul class="vl-list" role="list">
              {
                datos.map((d, i) => (
                  <li style={`--i:${i}`}>
                    {d.href ? (
                      <a class="vl-row" href={d.href} target={d.ext ? '_blank' : undefined} rel={d.ext ? 'noopener' : undefined} data-contact={d.id} data-cta="contacto">
                        <span class="vl-ic" aria-hidden="true">
                          {d.id === 'whatsapp' && <svg viewBox="0 0 24 24"><path d="M4.5 19.5l1.1-3.6A8 8 0 1 1 8.3 18.6z" /><path d="M9.2 8.6c.3 2.6 2.4 4.9 5.2 5.4l1-1.2 1.9.9-.4 1.6c-3.9.4-8-3.4-8.2-7.6l1.6-.5.9 1.9z" /></svg>}
                          {d.id === 'email' && <svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="1.5" /><path d="m3.6 6.4 8.4 6.8 8.4-6.8" /></svg>}
                          {d.id === 'instagram' && <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17" cy="7" r="0.6" /></svg>}
                        </span>
                        <span class="vl-tx"><span class="vl-l">{d.l}</span><b class="vl-v">{d.v}</b></span>
                        <svg class="vl-go" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
                      </a>
                    ) : (
                      <p class="vl-row">
                        <span class="vl-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z" /><circle cx="12" cy="10" r="2.4" /></svg></span>
                        <span class="vl-tx"><span class="vl-l">{d.l}</span><b class="vl-v">{d.v}</b><span class="vl-d">{d.d}</span></span>
                      </p>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
          <!-- parales y terreno -->
          <span class="vl-post vl-post-l" aria-hidden="true"></span>
          <span class="vl-post vl-post-r" aria-hidden="true"></span>
          <span class="vl-ground" aria-hidden="true"></span>
        </div>
      </div>
    </section>
    <Cierre />
  </main>
</Base>

<style>
  .ct { --pad: 20px; --hd: 76px; position: relative; isolation: isolate; min-height: 100svh; display: flex; padding: calc(var(--hd) + 10px) var(--pad) 26px; overflow: hidden; background: radial-gradient(70% 50% at 0% 0%, rgb(54 114 124 / 0.1), rgb(54 114 124 / 0) 70%), var(--color-bone); }
  .ct-in { width: 100%; max-width: 1180px; margin: auto; display: flex; flex-direction: column; gap: clamp(18px, 3.4svh, 34px); }
  .ct-copy { display: grid; justify-items: center; gap: 10px; text-align: center; }
  .ct-h1 { font-size: clamp(2.1rem, min(1.4rem + 3.4vw, 7svh), 4.4rem); line-height: 1.02; font-weight: 560; letter-spacing: -0.04em; text-wrap: balance; }
  .ct-h1 .accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--color-brand); font-size: 1.08em; letter-spacing: -0.012em; }
  .ct-sub { max-width: 30rem; font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.1rem); line-height: 1.45; color: var(--color-ink-soft); text-wrap: balance; }
  .ct-act { display: grid; justify-items: center; gap: 8px; margin-top: 4px; }
  .btn { --cut: 9px; display: inline-flex; align-items: center; gap: 8px; height: 50px; padding: 0 24px; font-size: 15px; font-weight: 560; background: var(--color-brand-ink); color: #fff; transition: background-color 0.3s; }
  .btn:hover { background: var(--color-ink); }
  .btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ct-note { max-width: 24rem; font-size: 12.5px; line-height: 1.4; color: var(--color-ink-mute); text-wrap: balance; }

  /* ---------- La valla ---------- */
  .vl { --post: 40px; position: relative; width: 100%; max-width: 560px; margin: 0 auto; padding-bottom: var(--post); }
  .vl-board { --cut: 16px; position: relative; z-index: 1; background: #fffdf9; box-shadow: inset 0 0 0 1.5px #23262b, 0 26px 40px -30px rgb(20 45 50 / 0.45); }
  .vl-hd { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 2px 12px; padding: 14px 16px 13px; background: var(--color-brand); color: #fff; }
  .vl-logo svg { display: block; width: 34px; height: auto; fill: #fff; }
  .vl-brand { display: grid; line-height: 1.15; }
  .vl-brand b { font-size: 16px; font-weight: 650; letter-spacing: -0.01em; }
  .vl-brand span { font-size: 12px; color: rgb(255 255 255 / 0.78); }
  .vl-resp { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 10px; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgb(255 255 255 / 0.28); }
  .vl-resp span { font-size: 11px; color: rgb(255 255 255 / 0.72); }
  .vl-resp b { font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: 17px; }
  .vl-list { padding: 4px 0; }
  .vl-list li + li { box-shadow: inset 0 1px 0 rgb(35 38 43 / 0.14); }
  .vl-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 11px 16px; color: inherit; }
  a.vl-row { transition: background-color 0.3s; }
  a.vl-row:hover { background: rgb(54 114 124 / 0.06); }
  .vl-ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px rgb(54 114 124 / 0.4); color: var(--color-brand); }
  .vl-ic svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .vl-tx { display: grid; min-width: 0; line-height: 1.25; }
  .vl-l { font-size: 11px; color: var(--color-ink-mute); }
  .vl-v { font-size: clamp(14px, 3.9vw, 16.5px); font-weight: 600; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .vl-d { font-size: 12.5px; color: var(--color-ink-soft); }
  .vl-go { width: 16px; height: 16px; fill: none; stroke: var(--color-brand); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.45s var(--ease-out-expo); }
  a.vl-row:hover .vl-go { transform: translateX(4px); }
  /* parales enterrados en el terreno */
  .vl-post { position: absolute; bottom: 6px; width: 10px; height: calc(var(--post) + 30px); background: linear-gradient(90deg, #cdbfa8, #e6dccb 45%, #c4b59c); box-shadow: inset 0 0 0 1px rgb(35 38 43 / 0.25); }
  .vl-post-l { left: 18%; }
  .vl-post-r { right: 18%; }
  .vl-ground { position: absolute; left: -6%; right: -6%; bottom: 0; height: 8px; border-top: 1.5px solid #23262b; background: repeating-linear-gradient(-45deg, rgb(35 38 43 / 0.35) 0 1px, transparent 1px 7px); }

  /* ---------- Entrada: suben los parales, se monta la valla y aparecen los datos ---------- */
  :global(html.js) .ct-copy > * { opacity: 0; transform: translateY(12px); }
  :global(html.js) .ct.is-in .ct-copy > * { opacity: 1; transform: none; transition: opacity 0.7s, transform 0.9s var(--ease-out-expo); }
  :global(html.js) .ct.is-in .ct-copy > :nth-child(2) { transition-delay: 0.1s; }
  :global(html.js) .ct.is-in .ct-copy > :nth-child(3) { transition-delay: 0.2s; }
  :global(html.js) .ct .vl-ground { transform: scaleX(0); }
  :global(html.js) .ct .vl-post { transform: scaleY(0); transform-origin: 50% 100%; }
  :global(html.js) .ct .vl-board { opacity: 0; transform: translateY(-22px); }
  :global(html.js) .ct .vl-list li { opacity: 0; transform: translateX(-10px); }
  :global(html.js) .ct.is-in .vl-ground { transform: none; transition: transform 0.7s cubic-bezier(0.6, 0, 0.3, 1) 0.2s; }
  :global(html.js) .ct.is-in .vl-post { transform: none; transition: transform 0.6s var(--ease-out-expo) 0.55s; }
  :global(html.js) .ct.is-in .vl-board { opacity: 1; transform: none; transition: opacity 0.4s 0.85s, transform 0.8s cubic-bezier(0.3, 1.35, 0.5, 1) 0.85s; }
  :global(html.js) .ct.is-in .vl-list li { opacity: 1; transform: none; transition: opacity 0.5s, transform 0.7s var(--ease-out-expo); transition-delay: calc(1.2s + var(--i) * 0.12s); }
  :global(html.rm) .ct * { transition: none !important; }
  :global(html.rm) .ct :is(.ct-copy > *, .vl-ground, .vl-post, .vl-board, .vl-list li) { opacity: 1 !important; transform: none !important; }

  @media (max-width: 639px) and (max-height: 700px) {
    .ct { padding-bottom: 14px; }
    .ct-in { gap: 16px; }
    .ct-note { display: none; }
    .vl { --post: 26px; }
    .vl-hd { padding: 11px 14px 10px; }
    .vl-row { padding: 8px 14px; gap: 10px; }
    .vl-ic { width: 32px; height: 32px; }
  }
  /* SE: valla compacta (sin íconos ni subtítulos) para que todo quepa y el correo vaya en una línea */
  @media (max-width: 639px) and (max-height: 600px) {
    .ct { padding-top: calc(var(--hd) + 2px); }
    .ct-in { gap: 12px; }
    .ct-h1 { font-size: 1.95rem; }
    .ct-sub, .vl-d, .vl-brand span, .vl-ic { display: none; }
    .vl { --post: 18px; }
    .vl-hd { padding: 9px 12px 8px; }
    .vl-logo svg { width: 26px; }
    .vl-resp { margin-top: 6px; padding-top: 6px; }
    .vl-resp b { font-size: 15px; }
    .vl-row { grid-template-columns: minmax(0, 1fr) auto; padding: 7px 12px; }
    .vl-v { font-size: 13px; letter-spacing: -0.02em; }
  }
  @media (min-width: 640px) {
    .ct { --pad: 28px; }
  }
  /* Escritorio: texto a la izquierda, valla a la derecha */
  @media (min-width: 1024px) {
    .ct { --pad: max(40px, calc((100% - 1180px) / 2)); --hd: 84px; }
    .ct-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 540px); align-items: center; gap: 64px; }
    .ct-copy { justify-items: start; text-align: left; }
    .ct-act { justify-items: start; }
    .vl { --post: 56px; }
    .vl-hd { padding: 18px 22px 16px; }
    .vl-logo svg { width: 40px; }
    .vl-brand b { font-size: 18px; }
    .vl-resp b { font-size: 19px; }
    .vl-row { padding: 14px 22px; }
  }
</style>

<script>
  document.documentElement.classList.add('ready');
  const sec = document.querySelector<HTMLElement>('[data-ct]');
  if (sec) requestAnimationFrame(() => sec.classList.add('is-in'));
</script>
