---
/**
 * El arquitecto: página propia de Ulises (pedido suyo: su presentación del portafolio y la foto profesional en grande).
 * 01 Héroe: la foto grande se descubre como una lámina que se levanta; su nombre y su rol.
 * 02 Presentación: su texto de presentación, tal cual lo envió (2026-11-12).
 * 03 Ficha: trayectoria (sin fechas mientras se confirma el dato de años) y programas. La formación ya va en 02.
 * Aprobada por Ulises (2026-11-12): sin noindex propio; se indexa cuando se quite PUBLIC_PREVIEW.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Plomada from '../components/Plomada.astro';
import Trazos from '../components/Trazos.astro';
import Cierre from '../components/Cierre.astro';
import foto from '../assets/ulises-pro.jpg';

const trayectoria = [
  { d: 'Gobernación del Cesar', t: 'Secretaría de Infraestructura: diseña, coordina y formula proyectos para las licitaciones del departamento.' },
  { d: 'Galezo Studio', t: 'Proyectos de arquitectura para clientes particulares, empresas privadas y alcaldías.' },
  { d: 'Vive Ámbar', t: 'Diseño de condominios de vivienda urbanos y campestres.' },
  { d: 'Construcol S.A.S.', t: 'Diseño de proyectos para una constructora que licita obra pública.' },
];
const programas = ['Revit', 'AutoCAD', 'SketchUp', 'D5 Render', 'Lumion', 'Photoshop'];
---

<Base title="Ulises Galezo Cifuentes, arquitecto · Galezo Studio" description="Conoce a Ulises Galezo Cifuentes, arquitecto de la Universidad del Atlántico y fundador de Galezo Studio, estudio de diseño arquitectónico en Valledupar." pageType="about">
  <Header />
  <main>
    <!-- 01 · Héroe -->
    <section class="aq" data-nav-label="El arquitecto" aria-labelledby="aq-title" data-aq>
      <div class="aq-in">
        <figure class="aq-photo">
          <Image src={foto} alt="Ulises Galezo Cifuentes, arquitecto, fundador de Galezo Studio" widths={[480, 760, 1100, 1420]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" fetchpriority="high" class="aq-img" />
          <span class="aq-cover" aria-hidden="true"></span>
        </figure>
        <div class="aq-copy">
          <p class="aq-role">Arquitecto · Fundador de Galezo Studio</p>
          <h1 id="aq-title" class="aq-h1"><span class="ln"><span class="ln-in">Ulises Galezo</span></span> <span class="ln"><span class="ln-in accent">Cifuentes</span></span></h1>
          <p class="aq-sub">Diseña cada proyecto del estudio, de la primera idea a los planos para construir.</p>
          <div class="aq-act">
            <a href="#cotizar" class="btn chamfer" data-open-chat data-cta="arquitecto">
              Cotiza tu diseño
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
            </a>
            <a href="#presentacion" class="aq-more">Conoce su historia</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · Presentación -->
    <section class="pt" id="presentacion" data-nav-label="Presentación" aria-labelledby="pt-title" data-rv>
      <Trazos left="norte" right="detalle" />
      <div class="pt-in">
        <Plomada n="01" label="Presentación" variant="firma" />
        <h2 id="pt-title" class="pt-h2 rv">La arquitectura es para <span class="accent">las personas</span></h2>
        <div class="pt-tx rv">
          <!-- texto de Ulises (2026-11-12), tal cual; solo se separó en párrafos -->
          <p class="pt-lead">Arquitecto egresado de la Universidad del Atlántico con 6 años de trayectoria sólida en la conceptualización, diseño y formulación técnica de proyectos de infraestructura pública y privada.</p>
          <p>Experiencia en la viabilización y evaluación técnica de obras de gran escala (cultura, deporte, educación, saneamiento y espacio público), asegurando el cumplimiento normativo en proyectos de Fase III.</p>
          <p>Mi enfoque se centra en la optimización de la calidad del diseño y la eficiencia en la ejecución, traduciendo requerimientos funcionales en soluciones arquitectónicas de alto valor mediante tecnología BIM.</p>
          <p>Capaz de liderar la planimetría integral y la presentación de proyectos ante entidades gubernamentales, con un enfoque orientado al éxito de la obra y la satisfacción del cliente.</p>
          <p class="pt-sign" aria-hidden="true">Ulises Galezo</p>
        </div>
      </div>
    </section>

    <!-- 03 · Ficha -->
    <section class="fi" id="trayectoria" data-nav-label="Trayectoria" aria-labelledby="fi-title" data-rv>
      <div class="fi-in">
        <Plomada n="02" label="Trayectoria" variant="obra" />
        <h2 id="fi-title" class="fi-h2 rv">De la obra pública <span class="accent">a tu casa</span></h2>
        <div class="fi-grid rv">
          <div class="fi-col">
            <p class="fi-l">Trayectoria</p>
            <ol class="fi-list" role="list">
              {trayectoria.map((x) => <li><b>{x.d}</b><span>{x.t}</span></li>)}
            </ol>
          </div>
          <div class="fi-col">
            <p class="fi-l">Programas que usa</p>
            <ul class="fi-tools" role="list">{programas.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <Cierre n="03" />
  </main>
</Base>

<style>
  /* ---------- 01 · Héroe ---------- */
  .aq { --pad: 20px; --hd: 76px; position: relative; min-height: 100svh; display: flex; padding: calc(var(--hd) + 8px) var(--pad) 22px; background: var(--color-bone); overflow: hidden; }
  .aq-in { width: 100%; max-width: 1180px; margin: auto; display: flex; flex-direction: column; gap: 18px; }
  .aq-photo { --cut: 18px; position: relative; margin: 0; height: 52svh; overflow: hidden; background: #2b2b2b; clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); }
  .aq-photo :global(.aq-img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 8%; display: block; }
  /* la lámina que se levanta y descubre la foto */
  .aq-cover { position: absolute; inset: 0; background: var(--color-brand); transform-origin: 50% 0; }
  .aq-copy { display: grid; justify-items: center; gap: 8px; text-align: center; }
  .aq-role { font-size: 13px; font-weight: 600; color: var(--color-brand-ink); }
  .aq-h1 { font-size: clamp(2.2rem, min(1.5rem + 3.6vw, 6.6svh), 4.8rem); line-height: 1; font-weight: 560; letter-spacing: -0.04em; }
  .aq-h1 .ln { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .aq-h1 .ln-in { display: inline-block; }
  .aq-h1 .accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--color-brand); font-size: 1.08em; letter-spacing: -0.012em; }
  .aq-sub { max-width: 28rem; font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.1rem); line-height: 1.45; color: var(--color-ink-soft); text-wrap: balance; }
  .aq-act { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 20px; margin-top: 6px; }
  .btn { --cut: 9px; display: inline-flex; align-items: center; gap: 8px; height: 50px; padding: 0 24px; font-size: 15px; font-weight: 560; background: var(--color-brand-ink); color: #fff; transition: background-color 0.3s; }
  .btn:hover { background: var(--color-ink); }
  .btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .aq-more { font-size: 14px; font-weight: 560; color: var(--color-brand-ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }

  :global(html.js) .aq .aq-cover { transform: none; }
  :global(html.js) .aq.is-in .aq-cover { transform: scaleY(0); transition: transform 1.1s cubic-bezier(0.7, 0, 0.2, 1) 0.15s; }
  :global(html.js) .aq .aq-img { transform: scale(1.08); }
  :global(html.js) .aq.is-in .aq-img { transform: none; transition: transform 2.2s var(--ease-out-expo) 0.3s; }
  :global(html.js) .aq .ln-in { transform: translateY(105%); }
  :global(html.js) .aq.is-in .ln-in { transform: none; transition: transform 0.9s var(--ease-out-expo) 0.7s; }
  :global(html.js) .aq.is-in .ln + .ln .ln-in { transition-delay: 0.82s; }
  :global(html.js) .aq :is(.aq-role, .aq-sub, .aq-act) { opacity: 0; transform: translateY(10px); }
  :global(html.js) .aq.is-in :is(.aq-role, .aq-sub, .aq-act) { opacity: 1; transform: none; transition: opacity 0.7s 1s, transform 0.9s var(--ease-out-expo) 1s; }
  :global(html.rm) .aq * { transition: none !important; }
  :global(html.rm) .aq .aq-cover { transform: scaleY(0) !important; }
  :global(html.rm) .aq :is(.aq-img, .ln-in, .aq-role, .aq-sub, .aq-act) { opacity: 1 !important; transform: none !important; }

  /* ---------- 02 · Presentación ---------- */
  .pt { --pad: 20px; --hd: 76px; position: relative; isolation: isolate; min-height: 100svh; display: flex; padding: calc(var(--hd) + 6px) var(--pad) 28px; background: #fff; overflow: hidden; }
  .pt-in { position: relative; z-index: 1; width: 100%; max-width: 760px; margin: auto; display: grid; justify-items: center; gap: clamp(12px, 2.6svh, 26px); }
  .pt-h2, .fi-h2 { font-size: clamp(1.7rem, min(1.2rem + 2.6vw, 5.4svh), 3.2rem); line-height: 1.04; font-weight: 560; letter-spacing: -0.037em; text-align: center; text-wrap: balance; }
  :is(.pt-h2, .fi-h2) .accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--color-brand); font-size: 1.08em; letter-spacing: -0.015em; }
  .pt-tx { display: grid; gap: 12px; font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.08rem); line-height: 1.55; color: var(--color-ink-soft); }
  .pt-lead { font-size: 1.18em; line-height: 1.42; color: var(--color-ink); font-weight: 500; letter-spacing: -0.012em; }
  .pt-sign { justify-self: end; margin-top: 2px; font-family: 'Architects Daughter', var(--font-serif); font-size: 1.5rem; color: var(--color-brand); rotate: -3deg; }

  /* ---------- 03 · Ficha ---------- */
  .fi { --pad: 20px; --hd: 76px; position: relative; min-height: 100svh; display: flex; padding: calc(var(--hd) + 6px) var(--pad) 28px; background: radial-gradient(80% 50% at 50% 0%, rgb(54 114 124 / 0.08), rgb(54 114 124 / 0) 70%), #f2f7f7; }
  .fi-in { width: 100%; max-width: 1100px; margin: auto; display: grid; justify-items: center; gap: clamp(12px, 2.6svh, 28px); }
  .fi-grid { width: 100%; display: grid; gap: 16px; }
  .fi-col { display: grid; align-content: start; gap: 8px; }
  .fi-l { font-size: 12px; font-weight: 600; color: var(--color-brand-ink); padding-bottom: 6px; border-bottom: 1.5px solid #23262b; }
  .fi-col .fi-l:not(:first-child) { margin-top: 10px; }
  .fi-list { display: grid; }
  .fi-list li { display: grid; gap: 2px; padding: 9px 0; box-shadow: inset 0 -1px 0 rgb(35 38 43 / 0.14); }
  .fi-list b, .fi-v b { font-size: 15px; font-weight: 650; letter-spacing: -0.01em; }
  .fi-list span, .fi-v span { font-size: 13.5px; line-height: 1.4; color: var(--color-ink-soft); }
  .fi-v { display: grid; gap: 2px; }
  .fi-tools { display: flex; flex-wrap: wrap; gap: 6px; }
  .fi-tools li { --cut: 6px; padding: 6px 11px; font-size: 13px; font-weight: 560; background: #fff; box-shadow: inset 0 0 0 1px rgb(35 38 43 / 0.16); }

  :global(html.js) [data-rv] .rv { opacity: 0; transform: translateY(16px); }
  :global(html.js) [data-rv].is-in .rv { opacity: 1; transform: none; transition: opacity 0.8s, transform 1s var(--ease-out-expo); }
  :global(html.js) [data-rv].is-in .rv + .rv { transition-delay: 0.15s; }
  :global(html.rm) [data-rv] .rv { opacity: 1 !important; transform: none !important; }

  /* celular: el texto de presentación de Ulises es largo; va más compacto y sin la firma para que quepa en una pantalla */
  @media (max-width: 639px) {
    .pt { padding-bottom: 18px; }
    .pt-in { gap: 12px; }
    .pt-tx { gap: 8px; font-size: 0.86rem; line-height: 1.42; }
    .pt-lead { font-size: 1.06em; line-height: 1.36; }
    .pt-sign { display: none; }
  }
  @media (max-width: 639px) and (max-height: 700px) {
    .aq-photo { height: 46svh; }
    .aq-sub { display: none; }
    .pt-tx { gap: 8px; }
    .pt-sign { font-size: 1.25rem; margin-top: 0; }
    .fi-list li { padding: 7px 0; }
    .fi-list span { font-size: 12.5px; }
  }
  @media (max-width: 639px) and (max-height: 600px) {
    .aq-photo { height: 42svh; }
    .pt-tx { font-size: 0.78rem; line-height: 1.36; gap: 6px; }
    .pt-h2 { font-size: 1.45rem; }
    .pt-lead { font-size: 1em; }
    .pt-sign { display: none; }
    .fi-list span { display: none; }
  }
  /* celular: la ficha compacta para que trayectoria y programas quepan */
  @media (max-width: 639px) {
    .fi-list li { padding: 7px 0; }
    .fi-list b { font-size: 14px; }
    .fi-list span { font-size: 12.5px; }
    .fi-tools li { padding: 4px 9px; font-size: 12px; }
    .fi-col .fi-l:not(:first-child) { margin-top: 4px; }
  }
  @media (min-width: 640px) {
    .aq, .pt, .fi { --pad: 28px; }
    .fi-grid { grid-template-columns: 1.4fr 1fr; gap: 40px; }
  }
  /* Escritorio: la foto en grande a la izquierda, a todo el alto */
  @media (min-width: 1024px) {
    .aq, .pt, .fi { --hd: 84px; }
    .aq { --pad: max(40px, calc((100% - 1180px) / 2)); }
    .aq-in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); align-items: center; gap: 64px; }
    .aq-photo { --cut: 26px; height: calc(100svh - var(--hd) - 50px); max-height: 860px; }
    .aq-copy { justify-items: start; text-align: left; gap: 12px; }
    .aq-act { justify-content: flex-start; }
    .pt-tx { font-size: 1.12rem; }
  }
</style>

<script>
  document.documentElement.classList.add('ready');
  const hero = document.querySelector<HTMLElement>('[data-aq]');
  if (hero) requestAnimationFrame(() => hero.classList.add('is-in'));
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.3 });
  document.querySelectorAll('[data-rv]').forEach((s) => io.observe(s));
</script>
