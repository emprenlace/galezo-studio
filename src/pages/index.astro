---
import Base from '../layouts/Base.astro';
import { estudio, website, faqPage } from '../lib/seo';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Entregable from '../components/Entregable.astro';
import Servicios from '../components/Servicios.astro';
import Obras from '../components/Obras.astro';
import Proceso from '../components/Proceso.astro';
import Estudio from '../components/Estudio.astro';
import Preguntas from '../components/Preguntas.astro';
import Cierre from '../components/Cierre.astro';
---

<Base
  schema={[estudio, website, faqPage]}
  pageType="home"
  title="Galezo Studio · Diseño arquitectónico de vivienda y obra pública"
  description="Diseñamos vivienda campestre y urbana, remodelaciones e interiores, proyectos comerciales e institucionales y proyectos ejecutivos en todo Colombia: planos, modelo BIM en Revit, renders, recorrido virtual y cantidades de obra para construir sin improvisar."
>
  <Header />
  <main>
    <Hero />
    <Entregable />
    <Servicios />
    <Obras />
    <Proceso />
    <Estudio />
    <Preguntas />
    <Cierre />
  </main>
</Base>
