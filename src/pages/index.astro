---
import Base from '../layouts/Base.astro';
import { estudio, website, faqPage } from '../lib/seo';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Entregable from '../components/Entregable.astro';
import Servicios from '../components/Servicios.astro';
import Obras from '../components/Obras.astro';
import Proceso from '../components/Proceso.astro';
import Estudio from '../components/Estudio.astro';
import Preguntas from '../components/Preguntas.astro';
import Cierre from '../components/Cierre.astro';
---

<Base
  schema={[estudio, website, faqPage]}
  pageType="home"
  title="Galezo Studio · Diseño de casas campestres y urbanas"
  description="Diseñamos casas campestres y urbanas en todo Colombia: planos arquitectónicos, renders, recorrido virtual y cantidades de obra para construir sin improvisar."
>
  <Header />
  <main>
    <Hero />
    <Entregable />
    <Servicios />
    <Obras />
    <Proceso />
    <Estudio />
    <Preguntas />
    <Cierre />
  </main>
</Base>
