---
import Base from '../layouts/Base.astro';
import { estudio, website, faqPage } from '../lib/seo';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Entregable from '../components/Entregable.astro';
import Servicios from '../components/Servicios.astro';
import Obras from '../components/Obras.astro';
import Proceso from '../components/Proceso.astro';
import Bim from '../components/Bim.astro';
import Estudio from '../components/Estudio.astro';
import Preguntas from '../components/Preguntas.astro';
import Cierre from '../components/Cierre.astro';
---

<Base
  schema={[estudio, website, faqPage]}
  pageType="home"
  title="Galezo Studio · Diseño arquitectónico en Valledupar"
  description="Diseño arquitectónico de vivienda, remodelación, comercio y obra pública en Colombia y el exterior: planos, modelo BIM, renders y cantidades de obra."
>
  <Header />
  <main>
    <Hero />
    <Entregable />
    <Servicios />
    <Obras />
    <Proceso />
    <Bim />
    <Estudio n="07" />
    <Preguntas n="08" />
    <Cierre n="09" />
  </main>
</Base>
