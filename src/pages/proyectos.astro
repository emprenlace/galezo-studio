---
/**
 * Proyectos: todos los proyectos del estudio en una página, organizados como en el portafolio de Ulises
 * (diseñados y construidos · diseñados y en construcción · diseñados · modelados y renderizados). Pedido de Ulises:
 * pestaña "Proyectos" en el menú y entrada también desde "Diseños ya construidos" del héroe del inicio.
 * - Arriba: la lámina con el título y los filtros (solo aparecen las categorías que ya tienen proyectos).
 * - Tarjetas: portada; con el mouse asoma la otra cara (render u obra). Al tocar, se abre la ficha.
 * - Ficha: todas las imágenes (obra, render, antes), datos confirmados y botón de cotizar. Se puede enlazar (#slug).
 * Datos en lib/proyectos.ts. noindex hasta que se apruebe. Carga: solo la primera portada de entrada; las demás, diferidas.
 */
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Cierre from '../components/Cierre.astro';
import { proyectos, CATEGORIAS, imagenesDe, TAG_LABEL, esDestacado } from '../lib/proyectos';
import { breadcrumb } from '../lib/seo';

const lista = await Promise.all(
  proyectos.map(async (p) => {
    const imgs = imagenesDe(p.slug);
    const big = await Promise.all(
      imgs.map(async (im) => {
        const r = await getImage({ src: im.src, widths: [800, 1300, 1800].filter((w) => w <= im.src.width + 200), format: 'webp', quality: 76 });
        const t = await getImage({ src: im.src, width: 180, format: 'webp', quality: 60 });
        return { src: r.src, set: r.srcSet.attribute, w: im.src.width, h: im.src.height, tag: im.tag, th: t.src };
      }),
    );
    // la otra cara para el paso del mouse: la primera imagen de distinto tipo que la portada
    const alt = imgs.find((im) => im.tag !== imgs[0].tag);
    // solo se pide en pantallas con mouse, después de la carga (en celular no hay paso del mouse)
    const cover = await getImage({ src: imgs[0].src, widths: [480, 760, 1000], format: 'webp', quality: 72 });
    const altSet = alt ? (await getImage({ src: alt.src, widths: [480, 760], format: 'webp', quality: 72 })).srcSet.attribute : '';
    return { ...p, imgs, big, alt, altSet, cover: { src: cover.src, set: cover.srcSet.attribute } };
  }),
);
const cats = CATEGORIAS.map((c) => ({ ...c, n: proyectos.filter((p) => p.cat === c.id).length })).filter((c) => c.n > 0);
const catLabel = Object.fromEntries(CATEGORIAS.map((c) => [c.id, c.short]));
const meta = (p: { city?: string; year?: string }) => [p.city, p.year].filter(Boolean).join(' · ');
// portadas: la primera de entrada; las demás cuando su tarjeta se acerca (la diferida del navegador adelanta ~2.500 px)
const CARD_SIZES = '(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw';
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const nDest = proyectos.filter((p) => esDestacado(p.slug)).length;
// estrella de los destacados: la misma figura en tarjeta, filtro y ficha
const star = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.8l2.47 5.3 5.8.68-4.3 3.96 1.17 5.73L10 14.6l-5.14 2.87 1.17-5.73-4.3-3.96 5.8-.68z"/></svg>';
const data = lista.map((p) => ({ slug: p.slug, dest: esDestacado(p.slug), n: p.n, name: p.name, tipo: p.tipo, cat: catLabel[p.cat], estado: p.estado, city: p.city, year: p.year, m2: p.m2, client: p.client, what: p.what, imgs: p.big }));
// primera tarjeta de cada categoría: ahí va el título de la sección (como en el portafolio)
const firstOf = new Set(CATEGORIAS.map((c) => lista.find((p) => p.cat === c.id)?.slug).filter(Boolean));
const catFull = Object.fromEntries(CATEGORIAS.map((c) => [c.id, c.label]));
const description = 'Proyectos de Galezo Studio: colegios, espacios públicos, escenarios deportivos y vivienda, diseñados y construidos en Colombia.';
---

<Base title="Proyectos · Galezo Studio" description={description} noindex pageType="projects" schema={[breadcrumb([['Inicio', '/'], ['Proyectos', '/proyectos']])]}>
  <Header />
  <main>
    <section class="pj" aria-labelledby="pj-title" data-pj>
      <div class="pj-paper" aria-hidden="true"></div>
      <div class="pj-in">
        <header class="pj-head">
          <nav class="pj-crumbs" aria-label="Ruta"><a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Proyectos</span></nav>
          <h1 id="pj-title" class="pj-h1">Proyectos <span class="accent">diseñados y construidos</span></h1>
          <p class="pj-sub">{proyectos.length} proyectos de vivienda, colegios, espacios públicos, escenarios deportivos e interiores. Toca uno para ver sus imágenes y su ficha.</p>
        </header>

        <div class="pj-filters" role="toolbar" aria-label="Filtrar proyectos" data-filters>
          <button type="button" class="fl is-on" aria-pressed="true" data-f="todos">Todos <span>{proyectos.length}</span></button>
          <button type="button" class="fl fl-dest" aria-pressed="false" data-f="destacados"><i set:html={star} />Destacados <span>{nDest}</span></button>
          {cats.map((c) => <button type="button" class="fl" aria-pressed="false" data-f={c.id}>{c.label} <span>{c.n}</span></button>)}
        </div>

        <ul class="grid" role="list" data-grid>
          {
            lista.map((p, i) => (
              <>
              {firstOf.has(p.slug) && <li class="sec" data-cat={p.cat}><h2 class="sec-t">{catFull[p.cat]}</h2></li>}
              <li class:list={['card', { 'is-dest': esDestacado(p.slug) }]} data-cat={p.cat} data-dest={esDestacado(p.slug) ? '' : undefined}>
                <a href={`#${p.slug}`} class="card-a" data-open={p.slug}>
                  <span class="card-ph chamfer">
                    {i === 0 ? (
                      <img src={p.cover.src} srcset={p.cover.set} sizes={CARD_SIZES} alt="" width={p.imgs[0].src.width} height={p.imgs[0].src.height} fetchpriority="high" decoding="async" class="card-img" />
                    ) : (
                      <>
                        <img src={PIXEL} data-cover={p.cover.src} data-cover-set={p.cover.set} sizes={CARD_SIZES} alt="" width={p.imgs[0].src.width} height={p.imgs[0].src.height} decoding="async" class="card-img" />
                        <noscript><img src={p.cover.src} srcset={p.cover.set} sizes={CARD_SIZES} alt="" class="card-img" /></noscript>
                      </>
                    )}
                    {p.alt && <img src={PIXEL} data-hover={p.altSet} sizes="(min-width: 1024px) 380px, 46vw" alt="" width={p.alt.src.width} height={p.alt.src.height} loading="lazy" decoding="async" class="card-img card-alt" />}
                    <span class="card-tag" aria-hidden="true"><span class="t1">{TAG_LABEL[p.imgs[0].tag]}</span>{p.alt && <span class="t2">{TAG_LABEL[p.alt.tag]}</span>}</span>
                    <span class={`card-st st-${p.cat}`}>{catLabel[p.cat]}</span>
                    {esDestacado(p.slug) && <span class="card-star" title="Proyecto destacado"><Fragment set:html={star} /><span class="sr-only">Destacado.</span></span>}
                  </span>
                  <span class="card-tx">
                    <span class="card-n">{String(p.n).padStart(2, '0')}</span>
                    <span class="card-t">{p.name}</span>
                    <span class="card-m">{[p.tipo, meta(p)].filter(Boolean).join(' · ')}</span>
                  </span>
                </a>
              </li>
              </>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Ficha del proyecto -->
    <dialog class="vw" aria-labelledby="vw-t" data-vw>
      <div class="vw-box">
        <button type="button" class="vw-x" aria-label="Cerrar" data-close><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3 3 13"></path></svg></button>
        <div class="vw-stage" data-stage>
          <img class="vw-img" alt="" data-img />
          <span class="vw-tag" data-tag></span>
          <button type="button" class="vw-nav vw-prev" aria-label="Imagen anterior" data-prev><svg viewBox="0 0 8 14" aria-hidden="true"><path d="M7 1 1 7l6 6"></path></svg></button>
          <button type="button" class="vw-nav vw-next" aria-label="Imagen siguiente" data-next><svg viewBox="0 0 8 14" aria-hidden="true"><path d="M1 1l6 6-6 6"></path></svg></button>
          <span class="vw-count" data-count></span>
        </div>
        <div class="vw-side">
          <p class="vw-k" data-k></p>
          <h2 id="vw-t" class="vw-t" data-t></h2>
          <dl class="vw-d" data-d></dl>
          <p class="vw-w" data-w></p>
          <ul class="vw-th" role="list" data-th></ul>
          <a href="#cotizar" class="btn chamfer" data-open-chat data-cta="proyectos">
            Cotiza un proyecto así
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
          </a>
        </div>
      </div>
    </dialog>
    <script type="application/json" id="pj-data" set:html={JSON.stringify(data)}></script>

    <Cierre n="02" />
  </main>
</Base>

<style>
  /* ---------- Lámina con título y filtros ---------- */
  .pj { --hd: 76px; --pad: 20px; --g: 8px; position: relative; isolation: isolate; padding: calc(var(--hd) + 26px) calc(var(--pad) + var(--g)) 56px; background: #fff; }
  .pj-paper { position: absolute; inset: var(--g) var(--g) 0; z-index: -1; background: radial-gradient(60% 40% at 0% 0%, rgb(54 114 124 / 0.1), rgb(54 114 124 / 0) 70%), var(--color-bone); clip-path: polygon(26px 0, 100% 0, 100% 100%, 0 100%, 0 26px); }
  .pj-in { max-width: 1200px; margin: 0 auto; display: grid; gap: 22px; }
  .pj-head { display: grid; justify-items: center; text-align: center; gap: 10px; }
  .pj-crumbs { display: flex; gap: 6px; font-size: 12.5px; color: var(--color-ink-mute); }
  .pj-crumbs a { color: var(--color-ink-mute); }
  .pj-crumbs a:hover { color: var(--color-brand-ink); }
  .pj-crumbs [aria-current] { color: var(--color-ink-soft); font-weight: 600; }
  .pj-h1 { font-size: clamp(2rem, 1.4rem + 3vw, 3.8rem); line-height: 1.02; font-weight: 560; letter-spacing: -0.04em; text-wrap: balance; }
  .pj-h1 .accent { display: block; font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; color: var(--color-brand); font-size: 1.04em; }
  .pj-sub { max-width: 34rem; font-size: 1rem; line-height: 1.5; color: var(--color-ink-soft); text-wrap: balance; }

  /* filtros: fila que se desliza en celular; quedan pegados bajo la cabecera al bajar */
  .pj-filters { position: sticky; top: calc(var(--hd) - 6px); z-index: 5; display: flex; gap: 8px; justify-content: safe center; margin: 0 calc((var(--pad) + var(--g)) * -1); padding: 10px calc(var(--pad) + var(--g)); overflow-x: auto; scrollbar-width: none; background: linear-gradient(var(--color-bone) 70%, rgb(244 242 238 / 0)); }
  .pj-filters::-webkit-scrollbar { display: none; }
  .fl { --cut: 7px; flex: none; display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 0 14px; border: 0; background: #fff; box-shadow: inset 0 0 0 1px rgb(11 13 16 / 0.12); font: inherit; font-size: 14px; font-weight: 560; color: var(--color-ink-soft); cursor: pointer; clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); transition: background-color 0.25s, color 0.25s; }
  .fl span { font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: 15px; color: var(--color-brand); }
  .fl:hover { color: var(--color-ink); }
  .fl.is-on { background: var(--color-brand-ink); color: #fff; box-shadow: none; }
  .fl.is-on span { color: #c4e0e3; }
  .fl:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  /* filtro de destacados: la estrella en dorado suave, como un sello sobre la lámina */
  .fl-dest :global(i) { display: grid; width: 15px; height: 15px; }
  .fl-dest :global(svg) { width: 100%; height: 100%; fill: #d9a441; }
  .fl-dest.is-on :global(svg) { fill: #f2c86b; }

  /* ---------- Tarjetas ---------- */
  .grid { display: grid; grid-template-columns: 1fr; gap: 26px 20px; margin: 0; padding: 0; list-style: none; }
  .card.is-out, .sec.is-out { display: none; }
  /* título de cada categoría cuando se ven todos */
  .sec { grid-column: 1 / -1; display: flex; align-items: center; gap: 14px; margin-top: 18px; }
  .sec:first-child { margin-top: 0; }
  .sec::after { content: ''; flex: 1; height: 1px; background: rgb(11 13 16 / 0.12); }
  .sec-t { font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: clamp(1.35rem, 1.1rem + 1vw, 1.8rem); letter-spacing: -0.01em; color: var(--color-brand-ink); }
  .card-a { display: grid; gap: 12px; color: inherit; }
  .card-ph { --cut: 16px; position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #e9e6df; }
  .card-ph :global(.card-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.6s, transform 1s var(--ease-out-expo); }
  .card-ph :global(.card-alt) { opacity: 0; }
  .card-tag { position: absolute; left: 12px; bottom: 12px; display: grid; padding: 3px 9px 4px; background: rgb(255 255 255 / 0.92); font-family: 'Architects Daughter', var(--font-sans); font-size: 13px; color: var(--color-brand-ink); }
  .card-tag > span { grid-area: 1 / 1; transition: opacity 0.4s; }
  .card-tag .t2 { opacity: 0; }
  .card-st { --cut: 5px; position: absolute; top: 12px; left: 12px; padding: 4px 9px 5px; font-size: 11.5px; font-weight: 600; line-height: 1; clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); }
  .st-construido { background: var(--color-brand); color: #fff; }
  .st-en-obra { background: #fff; color: var(--color-brand-ink); }
  .st-disenado, .st-modelado { background: rgb(11 13 16 / 0.6); color: #fff; }
  /* estrella de los destacados: arriba a la derecha, en una placa blanca con el corte a 45° de la marca */
  .card-star { --cut: 6px; position: absolute; top: 10px; right: 10px; display: grid; place-items: center; width: 34px; height: 34px; background: rgb(255 255 255 / 0.94); clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); box-shadow: 0 6px 14px -8px rgb(0 0 0 / 0.4); }
  .card-star :global(svg) { width: 19px; height: 19px; fill: #d9a441; }
  :global(html.js) .card.is-in .card-star :global(svg) { animation: pj-star 0.7s cubic-bezier(0.3, 1.6, 0.5, 1) 0.35s both; }
  @keyframes pj-star { from { opacity: 0; transform: scale(0.3) rotate(-40deg); } }
  :global(html.rm) .card-star :global(svg) { animation: none !important; }
  .card-tx { display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: baseline; }
  .card-n { grid-row: 1 / 3; font-family: var(--font-serif); font-style: italic; font-size: 18px; color: var(--color-brand); }
  .card-t { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .card-m { font-size: 13.5px; color: var(--color-ink-mute); }
  /* con mouse: la otra cara (render u obra) y un acercamiento leve */
  @media (hover: hover) and (pointer: fine) {
    .card-a:hover .card-ph :global(.card-alt) { opacity: 1; }
    .card-a:hover .card-ph :global(.card-img) { transform: scale(1.03); }
    .card-a:hover .card-tag .t1 { opacity: 0; }
    .card-a:hover .card-tag .t2 { opacity: 1; }
    .card-a:hover .card-t { color: var(--color-brand-ink); }
  }
  .card-a:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 4px; }
  /* entrada: las tarjetas suben una tras otra */
  /* cada tarjeta entra cuando se acerca (la sección es muy alta: no se puede esperar a que se vea un porcentaje de ella) */
  :global(html.js) .card { opacity: 0; transform: translateY(18px); }
  :global(html.js) .card.is-in { opacity: 1; transform: none; transition: opacity 0.7s calc(var(--d, 0) * 0.07s), transform 0.9s var(--ease-out-expo) calc(var(--d, 0) * 0.07s); }
  :global(html.rm) .card { opacity: 1 !important; transform: none !important; }

  @media (min-width: 640px) {
    .pj { --pad: 28px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .pj { --pad: max(40px, calc((100% - 1200px) / 2)); --hd: 84px; padding-top: calc(var(--hd) + 40px); }
    .pj-in { gap: 26px; }
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 24px; }
  }

  /* ---------- Ficha ---------- */
  .vw { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; }
  .vw::backdrop { background: rgb(11 13 16 / 0.72); }
  .vw[open] { animation: vw-in 0.35s var(--ease-out-expo); }
  @keyframes vw-in { from { opacity: 0; } }
  .vw-box { position: relative; display: flex; flex-direction: column; height: 100%; background: var(--color-bone); overflow-y: auto; overscroll-behavior: contain; }
  .vw-x { position: absolute; z-index: 3; top: 10px; right: 10px; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.92); cursor: pointer; }
  .vw-x svg { width: 16px; height: 16px; stroke: var(--color-ink); stroke-width: 1.8; stroke-linecap: round; }
  .vw-stage { position: relative; flex: none; height: 46svh; background: #1d2126; touch-action: pan-y; }
  .vw-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 0.3s; }
  .vw-img.is-loading { opacity: 0.25; }
  .vw-tag { position: absolute; left: 12px; top: 12px; padding: 3px 9px 4px; background: rgb(255 255 255 / 0.92); font-family: 'Architects Daughter', var(--font-sans); font-size: 14px; color: var(--color-brand-ink); }
  .vw-nav { position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.9); cursor: pointer; }
  .vw-nav svg { width: 8px; height: 14px; fill: none; stroke: var(--color-ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .vw-prev { left: 10px; }
  .vw-next { right: 10px; }
  .vw-nav[hidden] { display: none; }
  .vw-count { position: absolute; right: 12px; bottom: 10px; font-family: var(--font-serif); font-style: italic; font-size: 15px; color: rgb(255 255 255 / 0.85); }
  .vw-side { display: grid; gap: 10px; align-content: start; padding: 18px 20px 26px; }
  .vw-k { font-size: 12.5px; font-weight: 600; color: var(--color-brand-ink); }
  .vw-t { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .vw-d { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 2px 0 0; font-size: 14px; }
  .vw-d :global(dt) { color: var(--color-ink-mute); }
  .vw-d :global(dd) { margin: 0; font-weight: 560; color: var(--color-ink); }
  .vw-w { font-size: 15px; line-height: 1.5; color: var(--color-ink-soft); text-wrap: pretty; }
  .vw-th { display: flex; gap: 8px; margin: 4px 0 6px; padding: 0; list-style: none; overflow-x: auto; scrollbar-width: none; }
  .vw-th :global(button) { --cut: 6px; position: relative; flex: none; width: 72px; aspect-ratio: 4 / 3; padding: 0; border: 0; background: #ddd; cursor: pointer; clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); opacity: 0.6; transition: opacity 0.25s; }
  .vw-th :global(button.is-on) { opacity: 1; box-shadow: inset 0 0 0 2px var(--color-brand); }
  .vw-th :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .btn { --cut: 9px; justify-self: start; display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 22px; font-size: 15px; font-weight: 560; background: var(--color-brand-ink); color: #fff; transition: background-color 0.3s; }
  .btn:hover { background: var(--color-ink); }
  .btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 1024px) {
    .vw { width: min(1180px, calc(100vw - 64px)); height: min(720px, calc(100svh - 64px)); margin: auto; }
    .vw-box { --cut: 22px; flex-direction: row; overflow: hidden; clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut)); }
    .vw-stage { flex: 1; height: auto; }
    .vw-side { width: 380px; flex: none; overflow-y: auto; padding: 56px 28px 24px; align-content: center; gap: 9px; }
    .vw-t { font-size: 1.7rem; }
    /* la descripción del portafolio es larga: en pantallas bajitas va más compacta para que el botón quede a la vista */
    .vw-w { font-size: 14px; line-height: 1.5; }
  }
  @media (min-width: 1024px) and (max-height: 800px) {
    .vw-side { padding-top: 48px; gap: 7px; }
    .vw-t { font-size: 1.45rem; }
    .vw-d { font-size: 13px; gap: 2px 12px; }
    .vw-w { font-size: 13px; line-height: 1.45; }
    .vw-th :global(button) { width: 60px; }
  }
  :global(html.rm) .vw[open] { animation: none; }
</style>

<script>
  import { track } from '../lib/track';
  type Img = { src: string; set: string; w: number; h: number; tag: string; th: string };
  type P = { slug: string; dest: boolean; n: number; name: string; tipo: string; cat: string; estado: string; city?: string; year?: string; m2?: string; client?: string; what: string; imgs: Img[] };
  const data = JSON.parse(document.getElementById('pj-data')!.textContent!) as P[];
  const sec = document.querySelector<HTMLElement>('[data-pj]')!;
  const cards = [...sec.querySelectorAll<HTMLElement>('.card')];
  const fls = [...sec.querySelectorAll<HTMLButtonElement>('[data-f]')];
  const pio = new IntersectionObserver(
    (es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const im = e.target as HTMLImageElement;
      im.srcset = im.dataset.coverSet!;
      im.src = im.dataset.cover!;
      im.removeAttribute('data-cover');
      pio.unobserve(im);
    }),
    { rootMargin: '100% 0px' },
  );
  sec.querySelectorAll<HTMLImageElement>('img[data-cover]').forEach((im) => pio.observe(im));
  // la otra cara de las tarjetas: solo con mouse y cuando la página terminó de cargar (carga diferida del navegador)
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const caras = () => sec.querySelectorAll<HTMLImageElement>('img[data-hover]').forEach((im) => { im.srcset = im.dataset.hover!; im.removeAttribute('data-hover'); });
    if (document.readyState === 'complete') caras();
    else addEventListener('load', caras, { once: true });
  }

  // Filtros
  fls.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.f!;
      b.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      fls.forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      // destacados: solo las tarjetas con estrella, sin títulos de sección
      if (f === 'destacados') {
        cards.forEach((c) => c.classList.toggle('is-out', !c.hasAttribute('data-dest')));
        sec.querySelectorAll<HTMLElement>('.sec').forEach((s) => s.classList.add('is-out'));
      } else [...cards, ...sec.querySelectorAll<HTMLElement>('.sec')].forEach((c) => c.classList.toggle('is-out', f !== 'todos' && c.dataset.cat !== f));
      track('project_filter', { filter: f });
    }),
  );
  // entrada por tarjeta; las que entran juntas se escalonan un poco
  const cio = new IntersectionObserver((es) => {
    let d = 0;
    es.forEach((e) => { if (!e.isIntersecting) return; (e.target as HTMLElement).style.setProperty('--d', String(d++ % 4)); e.target.classList.add('is-in'); cio.unobserve(e.target); });
  }, { rootMargin: '0px 0px -6% 0px' });
  cards.forEach((c) => cio.observe(c));

  // Ficha
  const vw = document.querySelector<HTMLDialogElement>('[data-vw]')!;
  const $ = (s: string) => vw.querySelector<HTMLElement>(s)!;
  const img = $('[data-img]') as HTMLImageElement;
  const prev = $('[data-prev]'), next = $('[data-next]');
  let cur: P | null = null;
  let k = 0;
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
  const showImg = (i: number) => {
    if (!cur) return;
    k = (i + cur.imgs.length) % cur.imgs.length;
    const im = cur.imgs[k];
    img.classList.add('is-loading');
    img.onload = () => img.classList.remove('is-loading');
    img.sizes = '(min-width: 1024px) 820px, 100vw';
    img.srcset = im.set;
    img.src = im.src;
    img.alt = `${cur.name}: ${im.tag}`;
    $('[data-tag]').textContent = im.tag;
    $('[data-count]').textContent = `${k + 1} / ${cur.imgs.length}`;
    vw.querySelectorAll('[data-th] button').forEach((b, j) => b.classList.toggle('is-on', j === k));
  };
  const open = (slug: string, push = true) => {
    const p = data.find((x) => x.slug === slug);
    if (!p) return;
    cur = p;
    $('[data-k]').textContent = `${p.dest ? '★ Destacado · ' : ''}Proyecto ${String(p.n).padStart(2, '0')} · ${p.tipo}`;
    $('[data-t]').textContent = p.name;
    // mismos rótulos y orden de la ficha del portafolio
    const rows = [['Ubicación', p.city], ['Contratación', p.client], ['Año', p.year], ['Área de intervención', p.m2 && `${p.m2} m²`], ['Estado', p.estado]].filter(([, v]) => v) as [string, string][];
    $('[data-d]').innerHTML = rows.map(([a, b]) => `<dt>${esc(a)}</dt><dd>${esc(b)}</dd>`).join('');
    $('[data-w]').textContent = p.what;
    $('[data-th]').innerHTML = p.imgs.map((im, j) => `<li><button type="button" aria-label="Imagen ${j + 1}: ${esc(im.tag)}" data-k="${j}"><img src="${im.th}" alt="" loading="lazy" /></button></li>`).join('');
    $('[data-th]').querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => showImg(+b.dataset.k!)));
    prev.hidden = next.hidden = p.imgs.length < 2;
    showImg(0);
    if (!vw.open) vw.showModal();
    if (push) history.replaceState(null, '', `#${slug}`);
    track('project_open', { project_id: slug });
  };
  const close = () => { vw.close(); };
  vw.addEventListener('close', () => { history.replaceState(null, '', location.pathname + location.search); cur = null; });
  $('[data-close]').addEventListener('click', close);
  vw.addEventListener('click', (e) => { if (e.target === vw) close(); });
  prev.addEventListener('click', () => showImg(k - 1));
  next.addEventListener('click', () => showImg(k + 1));
  vw.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') showImg(k + 1); if (e.key === 'ArrowLeft') showImg(k - 1); });
  // deslizar en celular
  let x0 = 0, y0 = 0;
  const stage = $('[data-stage]');
  stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  stage.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.3) showImg(k + (dx < 0 ? 1 : -1)); }, { passive: true });
  // cotizar desde la ficha: se cierra para que el cotizador quede encima
  vw.querySelector('[data-open-chat]')!.addEventListener('click', () => close());

  sec.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); open(a.dataset.open!); }));
  // enlace directo a una ficha (#slug)
  const fromHash = () => { const h = decodeURIComponent(location.hash.slice(1)); if (h && data.some((x) => x.slug === h)) open(h, false); };
  fromHash();
  addEventListener('hashchange', fromHash);
</script>
