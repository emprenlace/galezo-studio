{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/servicios/casa-campestre",
      "destination": "/servicios/diseno-de-vivienda",
      "permanent": true
    },
    {
      "source": "/servicios/casa-urbana",
      "destination": "/servicios/diseno-de-vivienda",
      "permanent": true
    },
    {
      "source": "/servicios/remodelacion-y-ampliacion",
      "destination": "/servicios/remodelacion",
      "permanent": true
    },
    {
      "source": "/servicios/diseno-de-interiores",
      "destination": "/servicios/remodelacion",
      "permanent": true
    },
    {
      "source": "/servicios/remodelacion-e-interiores",
      "destination": "/servicios/remodelacion",
      "permanent": true
    },
    {
      "source": "/servicios/locales-comerciales",
      "destination": "/servicios/comercial-e-institucional",
      "permanent": true
    },
    {
      "source": "/servicios/obra-publica-e-institucional",
      "destination": "/servicios/comercial-e-institucional",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(brand|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
